@page "/players"
@inject TournamentApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<Strings> L

@* The central player list, shared by all tournaments. Players are created and edited in a drawer (PlayerEditDrawer). *@
<PageTitle>@L["Players"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Players"]</MudText>

<MudPaper Class="pa-2 pa-sm-4" Elevation="1">
    <div class="d-flex align-center gap-2 gap-sm-4 mb-3">
        <MudTextField @bind-Value="_filter" Placeholder="@L["Search"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Style="max-width: 20em" />
        <MudSpacer />
        <MudTooltip Text="@L["NewPlayer"]">
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                    aria-label="@L["NewPlayer"]" OnClick="OpenNew" />
        </MudTooltip>
    </div>

    @if (_players is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_players.Count == 0)
    {
        <MudText Typo="Typo.body2">@L["NoPlayersInList"]</MudText>
    }
    else
    {
        <MudTable T="PlayerDto" Items="FilteredPlayers" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.None">
            @* Also a table on a phone (no stacked cards): photo, city and club are left out there. *@
            <HeaderContent>
                <MudTh Class="hide-xs" Style="width: 3em"></MudTh>
                <MudTh>
                    <MudTableSortLabel T="PlayerDto" SortBy="p => p.FirstName" InitialDirection="SortDirection.Ascending">
                        @L["FirstName"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh><MudTableSortLabel T="PlayerDto" SortBy="p => p.LastName">@L["LastName"]</MudTableSortLabel></MudTh>
                <MudTh Class="hide-xs"><MudTableSortLabel T="PlayerDto" SortBy="p => p.City ?? string.Empty">@L["City"]</MudTableSortLabel></MudTh>
                <MudTh Class="hide-xs"><MudTableSortLabel T="PlayerDto" SortBy="p => ClubOf(p) ?? string.Empty">@L["Club"]</MudTableSortLabel></MudTh>
                <MudTh Style="text-align: right">
                    <MudTableSortLabel T="PlayerDto" SortBy="p => p.Rating">@L["Rating"]</MudTableSortLabel>
                </MudTh>
                <MudTh Style="width: 1%"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Class="hide-xs">
                    <PlayerAvatar FirstName="@context.FirstName" LastName="@context.LastName" PhotoUrl="@context.PhotoUrl" />
                </MudTd>
                <MudTd DataLabel="@L["FirstName"]">
                    <MudLink OnClick="() => OpenEdit(context)">@context.FirstName</MudLink>
                </MudTd>
                <MudTd DataLabel="@L["LastName"]">
                    <MudLink OnClick="() => OpenEdit(context)">@context.LastName</MudLink>
                    @if (context.IsGuest)
                    {
                        <GuestChip ClubName="@context.ClubName" />
                    }
                </MudTd>
                <MudTd DataLabel="@L["City"]" Class="hide-xs">@context.City</MudTd>
                <MudTd DataLabel="@L["Club"]" Class="hide-xs">@ClubOf(context)</MudTd>
                <MudTd DataLabel="@L["Rating"]" Style="text-align: right">@context.Rating</MudTd>
                <MudTd Style="text-align: right; width: 1%">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error"
                                   aria-label="@L["DeletePlayer"]" Disabled="_busy" OnClick="() => DeleteAsync(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<PlayerEditDrawer @ref="_editor" OnSaved="_ => ReloadAsync()" />

@code {
    private List<PlayerDto>? _players;
    private string? _ownClub;
    private string _filter = "";
    private PlayerEditDrawer? _editor;
    private bool _busy;

    private IEnumerable<PlayerDto> FilteredPlayers =>
        string.IsNullOrWhiteSpace(_filter)
            ? _players!
            : _players!.Where(p => Matches(p.Name) || Matches(p.City) || Matches(ClubOf(p)));

    /// <summary>The club of a guest player; own players belong to the own club.</summary>
    private string? ClubOf(PlayerDto player) => player.IsGuest ? player.ClubName : _ownClub;

    private bool Matches(string? text) => text?.Contains(_filter, StringComparison.CurrentCultureIgnoreCase) == true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var clubs = Api.GetClubsAsync();
        _players = await Api.GetPlayersAsync();
        _ownClub = (await clubs).FirstOrDefault(c => c.IsOwnClub)?.Name;
    }

    private async Task ReloadAsync()
    {
        try { await LoadAsync(); }
        catch (Exception) { /* keep showing the current list */ }
    }

    private void OpenNew() => _editor?.OpenNew();

    private void OpenEdit(PlayerDto player) => _editor?.OpenEdit(player);

    private async Task DeleteAsync(PlayerDto player)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["DeletePlayerTitle"], L["DeletePlayerText", player.Name], yesText: L["DeletePlayer"], cancelText: L["Cancel"]);
        if (confirmed != true) return;

        _busy = true;
        try
        {
            await Api.DeletePlayerAsync(player.Id);
            Snackbar.Add(L["PlayerDeleted", player.Name], Severity.Success);
        }
        catch (ApiClientException e)
        {
            Snackbar.Add(e.Code is { } code ? L[$"Error_{code}"] : L["Error_Unknown"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["Error_ServerUnavailable"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        await ReloadAsync();
    }
}
