@page "/players"
@inject TournamentApi Api
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L

@* The central player list, shared by all tournaments. *@
<PageTitle>@L["Players"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Players"]</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">@L["NewPlayer"]</MudText>
            <MudTextField @bind-Value="_newName" Label="@L["Name"]" Variant="Variant.Outlined" Immediate="true"
                          OnKeyUp="OnNewPlayerKeyUp" Disabled="_busy" Class="mb-2" />
            <MudNumericField T="int?" @bind-Value="_newRating" Label="@L["RatingOptional"]" Variant="Variant.Outlined"
                             Min="0" HideSpinButtons="true" Disabled="_busy" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                       Class="mt-3" Disabled="@(string.IsNullOrWhiteSpace(_newName) || _busy)"
                       OnClick="CreateAsync">@L["Create"]</MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="1">
            <div class="d-flex align-center justify-space-between gap-4 mb-3">
                <MudText Typo="Typo.h6">@L["Players"] (@(_players?.Count ?? 0))</MudText>
                <MudTextField @bind-Value="_filter" Placeholder="@L["Search"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Clearable="true" Style="max-width: 20em" />
            </div>

            @if (_players is null)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_players.Count == 0)
            {
                <MudText Typo="Typo.body2">@L["NoPlayersInList"]</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Striped="true">
                    <thead>
                        <tr>
                            <th>@L["Name"]</th>
                            <th style="text-align: right">@L["Rating"]</th>
                            <th style="width: 7em"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in FilteredPlayers)
                        {
                            @if (_editing?.Id == player.Id)
                            {
                                <tr>
                                    <td>
                                        <MudTextField @bind-Value="_editing.Name" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                      Immediate="true" OnKeyUp="OnEditKeyUp" AutoFocus="true" />
                                    </td>
                                    <td>
                                        <MudNumericField T="int?" @bind-Value="_editing.Rating" Margin="Margin.Dense" Variant="Variant.Outlined"
                                                         Min="0" HideSpinButtons="true" Style="text-align: right" />
                                    </td>
                                    <td style="text-align: right; white-space: nowrap">
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       aria-label="@L["Save"]" Disabled="_busy" OnClick="SaveEditAsync" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                       aria-label="@L["Cancel"]" OnClick="() => _editing = null" />
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td>@player.Name</td>
                                    <td style="text-align: right">@player.Rating</td>
                                    <td style="text-align: right">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       aria-label="@L["Edit"]" OnClick="() => StartEdit(player)" />
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<PlayerDto>? _players;
    private string _filter = "";
    private string _newName = "";
    private int? _newRating;
    private EditModel? _editing;
    private bool _busy;

    private IEnumerable<PlayerDto> FilteredPlayers =>
        string.IsNullOrWhiteSpace(_filter)
            ? _players!
            : _players!.Where(p => p.Name.Contains(_filter, StringComparison.CurrentCultureIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _players = await Api.GetPlayersAsync();

    private Task CreateAsync() => RunAsync(async () =>
    {
        var player = await Api.CreatePlayerAsync(_newName, _newRating);
        Snackbar.Add(L["PlayerCreated", player.Name], Severity.Success);
        _newName = "";
        _newRating = null;
    });

    private void StartEdit(PlayerDto player) => _editing = new EditModel(player.Id) { Name = player.Name, Rating = player.Rating };

    private Task SaveEditAsync() => RunAsync(async () =>
    {
        var player = await Api.UpdatePlayerAsync(_editing!.Id, _editing.Name, _editing.Rating);
        Snackbar.Add(L["PlayerUpdated", player.Name], Severity.Success);
        _editing = null;
    });

    private async Task OnNewPlayerKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newName)) await CreateAsync();
    }

    private async Task OnEditKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveEditAsync();
        else if (e.Key == "Escape") _editing = null;
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
        }
        catch (ApiClientException e)
        {
            Snackbar.Add(e.Code is { } code ? L[$"Error_{code}"] : L["Error_Unknown"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["Error_ServerUnavailable"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class EditModel(int id)
    {
        public int Id { get; } = id;
        public string Name { get; set; } = "";
        public int? Rating { get; set; }
    }
}
