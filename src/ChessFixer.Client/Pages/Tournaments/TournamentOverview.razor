@page "/tournament"
@implements IDisposable
@inject TournamentApi Api
@inject TournamentHubClient Hub
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject IStringLocalizer<Strings> L

@* All tournaments. The + button opens a wizard in a modal to create a new one. *@
<PageTitle>@L["Tournaments"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Tournaments"]</MudText>

<MudPaper Class="pa-2 pa-sm-4" Elevation="1">
    <div class="d-flex align-center mb-3">
        <MudSpacer />
        <MudTooltip Text="@L["NewTournament"]">
            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                    aria-label="@L["NewTournament"]" OnClick="OpenNew" />
        </MudTooltip>
    </div>

    <MudTable T="TournamentSummaryDto" Items="_tournaments" Hover="true" Loading="_tournaments is null" Elevation="0"
              OnRowClick="OnRowClick" Style="cursor: pointer" Breakpoint="Breakpoint.None">
        @* Also a table on a phone (no stacked cards): type, boards and time control are left out there. *@
        <HeaderContent>
            <MudTh>@L["Title"]</MudTh>
            <MudTh Class="hide-xs">@L["Type"]</MudTh>
            <MudTh Style="text-align: right">@L["Players"]</MudTh>
            <MudTh Class="hide-xs" Style="text-align: right">@L["BoardsAvailable"]</MudTh>
            <MudTh Class="hide-xs"><span title="@L["TimeControlHelp"]">@L["TimeControl"]</span></MudTh>
            <MudTh>@L["State"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Title"]">@context.Title</MudTd>
            <MudTd DataLabel="@L["Type"]" Class="hide-xs">@L[$"PairingSystem_{context.PairingSystem}"]</MudTd>
            <MudTd DataLabel="@L["Players"]" Style="text-align: right">@context.PlayerCount</MudTd>
            <MudTd DataLabel="@L["BoardsAvailable"]" Class="hide-xs" Style="text-align: right">@context.Boards</MudTd>
            <MudTd DataLabel="@L["TimeControl"]" Class="hide-xs">@Display.TimeControl(context.GameTimeMinutes, context.IncrementSeconds)</MudTd>
            <MudTd DataLabel="@L["State"]">
                <MudChip T="string" Size="Size.Small" Color="Display.StateColor(context.State)" Class="ma-0">
                    @L[$"State_{context.State}"]
                </MudChip>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>@L["NoTournaments"]</NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<TournamentSummaryDto>? _tournaments;

    protected override async Task OnInitializedAsync()
    {
        Hub.TournamentListChanged += OnTournamentListChanged;
        Hub.Connected += OnTournamentListChanged;
        Hub.EnsureStarted();
        await LoadAsync();
    }

    private async Task LoadAsync() => _tournaments = await Api.GetTournamentsAsync();

    private async Task OnTournamentListChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenNew()
    {
        // Clicking next to the wizard must not throw away what was filled in: only Cancel (or Escape) closes it.
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, BackdropClick = false };
        var dialog = await Dialogs.ShowAsync<TournamentCreateDialog>(L["NewTournament"], options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: TournamentDto tournament })
            Navigation.NavigateTo($"tournament/{tournament.Id}");
    }

    private void OnRowClick(TableRowClickEventArgs<TournamentSummaryDto> args) =>
        Navigation.NavigateTo($"tournament/{args.Item!.Id}");

    public void Dispose()
    {
        Hub.TournamentListChanged -= OnTournamentListChanged;
        Hub.Connected -= OnTournamentListChanged;
    }
}
