@page "/tournament/{Id:int}/players"
@inherits TournamentPageBase

<PageTitle>@L["Players"] · @(Tournament?.Title)</PageTitle>

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (IsNotFound || Tournament is null)
{
    <MudAlert Severity="Severity.Warning">@L["TournamentNotFound"]</MudAlert>
}
else
{
    <TournamentHeader Tournament="Tournament" Current="TournamentHeader.Page.Players" />

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">@L["AddPlayer"]</MudText>

                @if (LockReason is { } reason)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@reason</MudAlert>
                }
                else
                {
                    <MudAutocomplete @ref="_search" T="PlayerDto" Label="@L["SearchPlayer"]" Variant="Variant.Outlined"
                                     SearchFunc="SearchAsync" ToStringFunc="@(p => p?.Name)"
                                     ValueChanged="AddExistingAsync" Disabled="IsBusy"
                                     ResetValueOnEmptyText="true" CoerceText="false" Clearable="true"
                                     AdornmentIcon="@Icons.Material.Filled.Search">
                        <ItemTemplate Context="player">
                            @player.Name
                            @if (player.Rating is { } rating)
                            {
                                <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary"> (@rating)</MudText>
                            }
                        </ItemTemplate>
                        <NoItemsTemplate>
                            <MudText Class="pa-3" Typo="Typo.body2">@L["NoMatchingPlayers"]</MudText>
                        </NoItemsTemplate>
                    </MudAutocomplete>

                    <MudText Typo="Typo.subtitle1" Class="mt-6 mb-2">@L["NewPlayer"]</MudText>
                    <div class="d-flex gap-2 align-start">
                        <MudTextField @bind-Value="_newName" Label="@L["Name"]" Variant="Variant.Outlined" Immediate="true"
                                      OnKeyUp="OnNewPlayerKeyUp" Disabled="IsBusy" />
                        <MudNumericField T="int?" @bind-Value="_newRating" Label="@L["RatingOptional"]" Variant="Variant.Outlined"
                                         Min="0" Style="max-width: 11em" Disabled="IsBusy" HideSpinButtons="true" />
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                               Class="mt-2" Disabled="@(string.IsNullOrWhiteSpace(_newName) || IsBusy)"
                               OnClick="CreateAndAddAsync">@L["CreateAndAdd"]</MudButton>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">
                    @L["Players"] (@_participants.Count(p => p.IsActive))
                </MudText>

                @if (_participants.Count == 0)
                {
                    <MudText Typo="Typo.body2">@L["NoPlayers"]</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Striped="true">
                        <thead>
                            <tr>
                                <th>@L["Name"]</th>
                                <th style="text-align: right">@L["Rating"]</th>
                                <th>@L["State"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var player in _participants)
                            {
                                <tr class="@(player.IsActive ? null : "withdrawn")">
                                    <td>@player.Name</td>
                                    <td style="text-align: right">@player.Rating</td>
                                    <td>@(player.IsActive ? L["Active"] : L["Withdrawn"])</td>
                                    <td style="text-align: right">
                                        @if (player.IsActive)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small"
                                                           Color="Color.Error" aria-label="@L["Remove"]"
                                                           Disabled="@(!CanChangePlayers || IsBusy)"
                                                           OnClick="() => RemoveAsync(player)" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    @if (Tournament.RoundsStarted > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mt-2 d-block">@L["RemovedPlayerInfo"]</MudText>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private List<TournamentPlayerDto> _participants = [];
    private List<PlayerDto> _allPlayers = [];
    private MudAutocomplete<PlayerDto>? _search;
    private string _newName = "";
    private int? _newRating;

    protected override async Task LoadDataAsync()
    {
        var participants = Api.GetTournamentPlayersAsync(Id);
        var allPlayers = Api.GetPlayersAsync();
        _participants = await participants;
        _allPlayers = await allPlayers;
    }

    private string? LockReason => Tournament?.State switch
    {
        TournamentState.Closed => L["PlayersLockedClosed"].Value,
        TournamentState.RoundActive => L["PlayersLockedRound"].Value,
        _ when !CanChangePlayers => L["PlayersLockedRoundRobin"].Value,
        _ => null
    };

    /// <summary>Players from the central list that are not (actively) in this tournament yet.</summary>
    private Task<IEnumerable<PlayerDto>> SearchAsync(string? text, CancellationToken cancellationToken)
    {
        var active = _participants.Where(p => p.IsActive).Select(p => p.PlayerId).ToHashSet();
        var matches = _allPlayers
            .Where(p => !active.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(text) || p.Name.Contains(text, StringComparison.CurrentCultureIgnoreCase));
        return Task.FromResult(matches);
    }

    private async Task AddExistingAsync(PlayerDto? player)
    {
        if (player is null) return;
        await RunAsync(() => Api.AddPlayerAsync(Id, player.Id), L["PlayerAdded", player.Name]);
        if (_search is not null) await _search.ClearAsync();
    }

    private Task CreateAndAddAsync() => RunAsync(async () =>
    {
        var player = await Api.CreatePlayerAsync(_newName, _newRating);
        await Api.AddPlayerAsync(Id, player.Id);
        Snackbar.Add(L["PlayerAdded", player.Name], Severity.Success);
        _newName = "";
        _newRating = null;
    });

    private async Task OnNewPlayerKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newName)) await CreateAndAddAsync();
    }

    private Task RemoveAsync(TournamentPlayerDto player) =>
        RunAsync(() => Api.RemovePlayerAsync(Id, player.PlayerId), L["PlayerRemoved", player.Name]);
}
