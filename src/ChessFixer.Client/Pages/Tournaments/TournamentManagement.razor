@page "/tournament/{Id:int}"
@inherits TournamentPageBase
@using System.Globalization
@inject IDialogService Dialogs

<PageTitle>@(Tournament?.Title ?? L["Tournament"])</PageTitle>

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (IsNotFound || Tournament is null)
{
    <MudAlert Severity="Severity.Warning">@L["TournamentNotFound"]</MudAlert>
}
else
{
    <TournamentHeader Tournament="Tournament" Current="TournamentHeader.Page.Management" />

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">@L["Progress"]</MudText>

                <MudAlert Severity="@ProgressSeverity" Dense="true" Class="mb-4">@ProgressText</MudAlert>

                <div class="d-flex flex-wrap gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                               Disabled="@(!CanStartNextRound || IsBusy)" OnClick="StartNextRoundAsync">
                        @L["StartRound", Tournament.RoundsStarted + 1]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Flag"
                               Disabled="@(!CanClose || IsBusy)" OnClick="CloseAsync">
                        @L["CloseTournament"]
                    </MudButton>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">@L["Settings"]</MudText>

                @if (Tournament.SettingsLocked)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@L["SettingsLockedInfo"]</MudAlert>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_form.Title" Label="@L["Title"]" Variant="Variant.Outlined"
                                      Disabled="IsClosed" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSelect T="PairingSystem" @bind-Value="_form.PairingSystem" Label="@L["PairingSystem"]"
                                   Variant="Variant.Outlined" Disabled="SettingsDisabled">
                            @foreach (var system in Enum.GetValues<PairingSystem>())
                            {
                                <MudSelectItem Value="system">@L[$"PairingSystem_{system}"]</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int" @bind-Value="_form.GameTimeMinutes" Label="@L["GameTime"]"
                                         Variant="Variant.Outlined" Min="1" Disabled="SettingsDisabled" Immediate="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int" @bind-Value="_form.IncrementSeconds" Label="@L["Increment"]"
                                         Variant="Variant.Outlined" Min="0" Disabled="SettingsDisabled" Immediate="true" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="double" @bind-Value="_form.PointsForWin" Label="@L["PointsForWin"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="SettingsDisabled" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="double" @bind-Value="_form.PointsForDraw" Label="@L["PointsForDraw"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="SettingsDisabled" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="double" @bind-Value="_form.PointsForLoss" Label="@L["PointsForLoss"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="SettingsDisabled" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField T="double" @bind-Value="_form.PointsForBye" Label="@L["PointsForBye"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="SettingsDisabled" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-end mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(!IsDirty || IsBusy || IsClosed)" OnClick="SaveAsync">@L["Save"]</MudButton>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private SettingsForm _form = new();
    private UpdateTournamentRequest? _loaded;

    private bool IsClosed => Tournament?.State == TournamentState.Closed;
    private bool SettingsDisabled => Tournament is null || Tournament.SettingsLocked || IsClosed;
    private bool IsDirty => _loaded is not null && _form.ToRequest() != _loaded;
    private bool CanClose => Tournament?.State is TournamentState.New or TournamentState.WaitingForNextRound;

    /// <summary>Takes over the server values, unless the user is busy editing the form.</summary>
    protected override void OnTournamentLoaded()
    {
        var wasDirty = IsDirty;
        _loaded = SettingsForm.From(Tournament!).ToRequest();
        if (!wasDirty) _form = SettingsForm.From(Tournament!);
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        await Api.UpdateTournamentAsync(Id, _form.ToRequest());
        _loaded = null; // force the form to take over the saved values
    }, L["Saved"]);

    private Task StartNextRoundAsync() =>
        RunAsync(() => Api.StartNextRoundAsync(Id), L["RoundStarted", Tournament!.RoundsStarted + 1]);

    private async Task CloseAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["CloseConfirmTitle"], L["CloseConfirmText"], yesText: L["CloseTournament"], cancelText: L["Cancel"]);
        if (confirmed == true)
            await RunAsync(() => Api.CloseAsync(Id), L["TournamentClosed"]);
    }

    private Severity ProgressSeverity => Tournament?.State switch
    {
        TournamentState.RoundActive => Severity.Success,
        TournamentState.WaitingForNextRound => Severity.Warning,
        TournamentState.Closed => Severity.Normal,
        _ => Severity.Info
    };

    private string ProgressText => Tournament!.State switch
    {
        TournamentState.New => L["NewInfo"],
        TournamentState.RoundActive => L["RoundActiveInfo", Tournament.RoundsStarted],
        TournamentState.WaitingForNextRound when AllRoundsPlayed => L["AllRoundsPlayedInfo"],
        TournamentState.WaitingForNextRound => L["WaitingInfo", Tournament.RoundsStarted],
        _ => L["ClosedInfo"]
    };

    private sealed class SettingsForm
    {
        public string Title { get; set; } = "";
        public PairingSystem PairingSystem { get; set; }
        public int GameTimeMinutes { get; set; }
        public int IncrementSeconds { get; set; }
        public double PointsForWin { get; set; }
        public double PointsForDraw { get; set; }
        public double PointsForLoss { get; set; }
        public double PointsForBye { get; set; }

        public static SettingsForm From(TournamentDto t) => new()
        {
            Title = t.Title,
            PairingSystem = t.Settings.PairingSystem,
            GameTimeMinutes = t.Settings.GameTimeMinutes,
            IncrementSeconds = t.Settings.IncrementSeconds,
            PointsForWin = t.Settings.PointsForWin,
            PointsForDraw = t.Settings.PointsForDraw,
            PointsForLoss = t.Settings.PointsForLoss,
            PointsForBye = t.Settings.PointsForBye
        };

        public UpdateTournamentRequest ToRequest() => new(
            Title,
            new TournamentSettingsDto(PairingSystem, GameTimeMinutes, IncrementSeconds,
                PointsForWin, PointsForDraw, PointsForLoss, PointsForBye));
    }
}
