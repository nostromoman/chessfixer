@page "/tournament/{Id:int}"
@inherits TournamentPageBase
@using System.Globalization
@inject IDialogService Dialogs

@* One tournament: progress, and tabs for players, matches and standings (and the report once closed).
   Settings are in a drawer. *@
<PageTitle>@(Tournament?.Title ?? L["Tournament"])</PageTitle>

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (IsNotFound || Tournament is null)
{
    <MudAlert Severity="Severity.Warning">@L["TournamentNotFound"]</MudAlert>
}
else
{
    <TournamentHeader Tournament="Tournament" OnOpenSettings="OpenSettings" />

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <div class="d-flex align-center gap-3 mb-4">
            <MudIcon Icon="@StatusIcon" Color="@StatusColor" Size="Size.Large" />
            <MudText Typo="Typo.h6">@StatusText</MudText>
        </div>

        <div class="d-flex flex-wrap align-center gap-2">
            @if (Tournament.State == TournamentState.RoundActive)
            {
                @* During a round the start button becomes the cancel button. *@
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Cancel"
                           Disabled="IsBusy" OnClick="CancelRoundAsync">
                    @L["CancelCurrentRound"]
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@(StartBlockedReason is not null || !CanStartNextRound || IsBusy)" OnClick="StartNextRoundAsync">
                    @L["StartRound", Tournament.RoundsStarted + 1]
                </MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Flag"
                       Disabled="@(!CanClose || IsBusy)" OnClick="CloseAsync">
                @L["CloseTournament"]
            </MudButton>

        </div>
        @if (StartBlockedReason is { } blocked)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">@blocked</MudText>
        }
    </MudPaper>

    @* On a phone the tabs show only their icon (tabs-icons-xs in app.css). *@
    <MudPaper Elevation="1">
        <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pa-2 pa-sm-4"
                 Class="tabs-icons-xs">
            <MudTabPanel Text="@($"{L["Players"]} ({ActivePlayerCount})")" Icon="@Icons.Material.Filled.People">
                <TournamentPlayersTab Tournament="Tournament" Participants="_participants" Rounds="_rounds"
                                      Players="_players" CanChangePlayers="CanChangePlayers" Disabled="IsBusy" Run="RunAsync"
                                      OnOpenPlayer="OpenPlayer" />
            </MudTabPanel>
            <MudTabPanel Text="@L["Matches"]" Icon="@Icons.Material.Filled.GridOn">
                <TournamentMatchesTab Tournament="Tournament" Rounds="_rounds" Players="_players"
                                      Disabled="IsBusy" OnResult="SetResultAsync" />
            </MudTabPanel>
            <MudTabPanel Text="@L["Standings"]" Icon="@Icons.Material.Filled.EmojiEvents">
                <div class="standings-centered">
                    @if (_standings.Any(s => s.Played > 0 || s.Points > 0))
                    {
                        <StandingsTable Standings="_standings" OnPlayerClick="OpenPlayer" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@L["NoResultsYet"]</MudText>
                    }
                </div>
            </MudTabPanel>
            @if (IsClosed)
            {
                <MudTabPanel Text="@L["Report"]" Icon="@Icons.Material.Filled.AutoAwesome">
                    <TournamentReportTab TournamentId="Id" Report="Tournament.Report" Disabled="IsBusy" OnGenerate="GenerateReportAsync" />
                </MudTabPanel>
            }
        </MudTabs>
    </MudPaper>

    <MudDrawer Open="_settingsOpen" OpenChanged="OnSettingsOpenChanged" Anchor="Anchor.End"
               Variant="DrawerVariant.Temporary" Overlay="true" Elevation="2" Width="50vw" Class="side-drawer">
        <MudDrawerHeader Class="d-flex align-center">
            <MudText Typo="Typo.h6">@L["Settings"]</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L["Close"]" OnClick="CloseSettings" />
        </MudDrawerHeader>

        <div class="px-6 pb-6">
            @if (!CanEditSettings)
            {
                @* During a round or after closing nothing can change: show the settings as text. *@
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @(IsClosed ? L["PlayersLockedClosed"] : L["SettingsRoundActiveInfo"])
                </MudAlert>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><th style="width: 45%">@L["Title"]</th><td>@Tournament.Title</td></tr>
                        <tr><th>@L["Location"]</th><td>@Tournament.Location</td></tr>
                        <tr><th>@L["Description"]</th><td style="white-space: pre-line">@Tournament.Description</td></tr>
                        <tr><th>@L["Boards"]</th><td>@Tournament.Settings.Boards</td></tr>
                        <tr><th>@L["GameTime"]</th><td>@Tournament.Settings.GameTimeMinutes</td></tr>
                        <tr><th>@L["Increment"]</th><td>@Tournament.Settings.IncrementSeconds</td></tr>
                        <tr><th>@L["PairingSystem"]</th><td>@L[$"PairingSystem_{Tournament.Settings.PairingSystem}"]</td></tr>
                        <tr><th>@L["PointsForWin"]</th><td>@Display.Points(Tournament.Settings.PointsForWin)</td></tr>
                        <tr><th>@L["PointsForDraw"]</th><td>@Display.Points(Tournament.Settings.PointsForDraw)</td></tr>
                        <tr><th>@L["PointsForLoss"]</th><td>@Display.Points(Tournament.Settings.PointsForLoss)</td></tr>
                        <tr><th>@L["PointsForBye"]</th><td>@Display.Points(Tournament.Settings.PointsForBye)</td></tr>
                        <tr><th>@L["PointsForAbsence"]</th><td>@Display.Points(Tournament.Settings.PointsForAbsence)</td></tr>
                        <tr><th>@L["IsRated"]</th><td>@(Tournament.Settings.IsRated ? L["Yes"] : L["No"])</td></tr>
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12"><MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@L["SettingsGeneral"]</MudText></MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_form.Title" Label="@L["Title"]" Variant="Variant.Outlined" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_form.Location" Label="@L["Location"]" Placeholder="@L["LocationPlaceholder"]"
                                      Variant="Variant.Outlined" Immediate="true" MaxLength="200" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_form.Description" Label="@L["Description"]" HelperText="@L["DescriptionHelp"]"
                                      Variant="Variant.Outlined" Immediate="true" Lines="3" Sizing="InputSizing.Auto" MaxLines="10" MaxLength="2000" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="int" @bind-Value="_form.Boards" Label="@L["Boards"]" HelperText="@L["BoardsHelp"]"
                                         Variant="Variant.Outlined" Min="1" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="int" @bind-Value="_form.GameTimeMinutes" Label="@L["GameTime"]"
                                         Variant="Variant.Outlined" Min="1" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="int" @bind-Value="_form.IncrementSeconds" Label="@L["Increment"]"
                                         Variant="Variant.Outlined" Min="0" Immediate="true" />
                    </MudItem>

                    <MudItem xs="12"><MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-4">@L["SettingsPairingAndPoints"]</MudText></MudItem>
                    @if (Tournament.SettingsLocked)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Info" Dense="true">@L["SettingsLockedInfo"]</MudAlert>
                        </MudItem>
                    }
                    <MudItem xs="12">
                        <MudSelect T="PairingSystem" @bind-Value="_form.PairingSystem" Label="@L["PairingSystem"]"
                                   Variant="Variant.Outlined" Disabled="Tournament.SettingsLocked">
                            @foreach (var system in Enum.GetValues<PairingSystem>())
                            {
                                <MudSelectItem Value="system">@L[$"PairingSystem_{system}"]</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="double" @bind-Value="_form.PointsForWin" Label="@L["PointsForWin"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="Tournament.SettingsLocked" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="double" @bind-Value="_form.PointsForDraw" Label="@L["PointsForDraw"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="Tournament.SettingsLocked" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="double" @bind-Value="_form.PointsForLoss" Label="@L["PointsForLoss"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="Tournament.SettingsLocked" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="double" @bind-Value="_form.PointsForBye" Label="@L["PointsForBye"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="Tournament.SettingsLocked" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudNumericField T="double" @bind-Value="_form.PointsForAbsence" Label="@L["PointsForAbsence"]"
                                         HelperText="@L["PointsForAbsenceHelp"]"
                                         Variant="Variant.Outlined" Min="0" Step="0.5" Disabled="Tournament.SettingsLocked" Immediate="true" Culture="CultureInfo.CurrentCulture" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudSwitch T="bool" @bind-Value="_form.IsRated" Label="@L["IsRated"]" Color="Color.Primary"
                                   Disabled="Tournament.SettingsLocked" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@L["IsRatedHelp"]</MudText>
                    </MudItem>
                </MudGrid>

                <div class="d-flex gap-2 justify-end mt-4">
                    <MudButton Variant="Variant.Text" OnClick="CloseSettings" Disabled="IsBusy">@L["Cancel"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                               Disabled="@(!IsDirty || IsBusy)" OnClick="SaveAsync">@L["Save"]</MudButton>
                </div>
            }
        </div>
    </MudDrawer>
}

@* The same player drawer as on the Players page, opened from the Players and Standings tabs. *@
<PlayerEditDrawer @ref="_playerDrawer" OnSaved="_ => RunAsync(() => Task.CompletedTask)" />

@code {
    private const int PlayersTab = 0, MatchesTab = 1, StandingsTab = 2, ReportTab = 3;

    private List<TournamentPlayerDto> _participants = [];
    private Dictionary<int, PlayerDto> _players = [];
    private List<RoundDto> _rounds = [];
    private List<StandingDto> _standings = [];

    private int _activeTab;
    private bool _initialTabChosen;
    private bool _settingsOpen;
    private PlayerEditDrawer? _playerDrawer;

    private SettingsForm _form = new();
    private UpdateTournamentRequest? _loaded;

    private int ActivePlayerCount => _participants.Count(p => p.IsActive);
    private bool IsClosed => Tournament?.State == TournamentState.Closed;
    /// <summary>Settings can change before and between rounds, not during a round or after closing.</summary>
    private bool CanEditSettings => Tournament?.State is TournamentState.New or TournamentState.WaitingForNextRound;
    private bool IsDirty => _loaded is not null && _form.ToRequest() != _loaded;
    /// <summary>Why the next round cannot start yet (not enough players or boards), or null.</summary>
    private string? StartBlockedReason =>
        !CanStartNextRound ? null
        : Tournament!.Settings.Boards < 1 ? L["StartBlockedBoards"].Value
        : ActivePlayerCount < 2 ? L["StartBlockedPlayers"].Value
        : !_rounds.Any(r => !r.IsStarted) ? L["NoPairingPossible"].Value
        : null;

    private bool CanClose => Tournament?.State is TournamentState.New or TournamentState.WaitingForNextRound;

    protected override async Task LoadDataAsync()
    {
        var participants = Api.GetTournamentPlayersAsync(Id);
        var allPlayers = Api.GetPlayersAsync(includeDeleted: true);
        var rounds = Api.GetRoundsAsync(Id);
        var standings = Api.GetStandingsAsync(Id);
        _participants = await participants;
        _players = (await allPlayers).ToDictionary(p => p.Id);
        _rounds = await rounds;
        _standings = await standings;
    }

    /// <summary>Takes over the server values, unless the user is busy editing the settings.</summary>
    protected override void OnTournamentLoaded()
    {
        var wasDirty = IsDirty;
        _loaded = SettingsForm.From(Tournament!).ToRequest();
        if (!wasDirty) _form = SettingsForm.From(Tournament!);

        if (!_initialTabChosen)
        {
            // Open the tab that matters most right now.
            _activeTab = Tournament!.State switch
            {
                TournamentState.New => PlayersTab,
                TournamentState.Closed when HasReport => ReportTab,
                TournamentState.Closed => StandingsTab,
                _ => MatchesTab
            };
            _initialTabChosen = true;
        }
    }

    private void OpenPlayer(int playerId)
    {
        if (_players.TryGetValue(playerId, out var player)) _playerDrawer?.OpenEdit(player);
    }

    private void OpenSettings()
    {
        _form = SettingsForm.From(Tournament!);
        _settingsOpen = true;
    }

    /// <summary>Closing the drawer without saving discards the changes.</summary>
    private void CloseSettings() => OnSettingsOpenChanged(false);

    private void OnSettingsOpenChanged(bool open)
    {
        _settingsOpen = open;
        if (!open && Tournament is not null) _form = SettingsForm.From(Tournament);
    }

    private async Task SaveAsync()
    {
        await RunAsync(async () =>
        {
            await Api.UpdateTournamentAsync(Id, _form.ToRequest());
            _loaded = null; // force the form to take over the saved values
        }, L["Saved"]);

        if (!IsDirty) _settingsOpen = false;
    }

    private Task SetResultAsync((GameDto Game, GameResult Result) change) =>
        RunAsync(() => Api.SetResultAsync(Id, change.Game.Id, change.Result));

    private async Task StartNextRoundAsync()
    {
        var round = Tournament!.RoundsStarted + 1;

        if (round == 1)
        {
            // Last chance to change the settings: ask for confirmation first.
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                L["StartFirstRoundTitle"], L["StartFirstRoundText"], yesText: L["StartRound", 1], cancelText: L["Cancel"]);
            if (confirmed != true) return;
        }

        // Players who would meet for the third time (or more): only when it could not be avoided, but ask first.
        var repeats = _rounds.FirstOrDefault(r => !r.IsStarted)?.Games.Count(g => g.TimesMetBefore >= 2) ?? 0;
        if (repeats > 0)
        {
            var confirmed = await Dialogs.ShowMessageBoxAsync(
                L["StartWithRepeatsTitle"], L["StartWithRepeatsText", repeats], yesText: L["StartRound", round], cancelText: L["Cancel"]);
            if (confirmed != true) return;
        }

        await RunAsync(() => Api.StartNextRoundAsync(Id), L["RoundStarted", round]);
        if (Tournament?.State == TournamentState.RoundActive) _activeTab = MatchesTab;
    }

    /// <summary>A round without results that started less than this long ago is cancelled without asking.</summary>
    private static readonly TimeSpan CancelWithoutConfirmation = TimeSpan.FromMinutes(1);

    private async Task CancelRoundAsync()
    {
        if (_rounds.LastOrDefault(r => r.IsStarted) is not { } round) return;

        var resultCount = round.Games.Count(g => g.Black is not null && g.Result != GameResult.NotPlayed);
        var running = round.StartedAt is { } startedAt ? DateTime.UtcNow - startedAt : TimeSpan.Zero;
        if (resultCount > 0 || running > CancelWithoutConfirmation)
        {
            var dialog = await Dialogs.ShowAsync<CancelRoundDialog>(null,
                new DialogParameters<CancelRoundDialog>
                {
                    { d => d.RoundNumber, round.Number },
                    { d => d.ResultCount, resultCount },
                    { d => d.MinutesRunning, (int)running.TotalMinutes }
                },
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true });
            if (await dialog.Result is not { Canceled: false }) return;
        }

        await RunAsync(() => Api.CancelRoundAsync(Id), L["RoundCancelled", round.Number]);
    }

    private async Task CloseAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["CloseConfirmTitle"], L["CloseConfirmText"], yesText: L["CloseTournament"], cancelText: L["Cancel"]);
        if (confirmed != true) return;

        await RunAsync(() => Api.CloseAsync(Id), L["TournamentClosed"]);
        // The report is written on request: show the tab with the button for it.
        if (IsClosed) _activeTab = ReportTab;
    }

    private Task GenerateReportAsync(GenerateReportRequest request) =>
        RunAsync(() => Api.GenerateReportAsync(Id, request), L["ReportRequested"]);

    /// <summary>A report exists or is being written.</summary>
    private bool HasReport => Tournament?.Report is { } r && (r.Text is not null || r.Status == ReportStatus.Generating);

    /// <summary>The real games (without byes) of the most recent started round.</summary>
    private List<GameDto> CurrentGames =>
        _rounds.LastOrDefault(r => r.IsStarted)?.Games.Where(g => g.Black is not null).ToList() ?? [];

    private string StatusIcon => Tournament?.State switch
    {
        TournamentState.RoundActive => Icons.Material.Filled.HourglassTop,
        TournamentState.WaitingForNextRound => Icons.Material.Filled.CheckCircle,
        TournamentState.Closed => Icons.Material.Filled.Flag,
        _ => Icons.Material.Filled.Info
    };

    private Color StatusColor => Tournament?.State switch
    {
        TournamentState.RoundActive => Color.Warning,
        TournamentState.WaitingForNextRound => Color.Success,
        TournamentState.Closed => Color.Default,
        _ => Color.Info
    };

    private string StatusText => Tournament!.State switch
    {
        TournamentState.New => L["NewInfo"],
        TournamentState.RoundActive => L["RoundInProgressStatus",
            CurrentGames.Count(g => g.Result != GameResult.NotPlayed), CurrentGames.Count, Tournament.RoundsStarted],
        TournamentState.WaitingForNextRound => L["RoundFinishedStatus", Tournament.RoundsStarted],
        _ => L["ClosedInfo"]
    };

    private sealed class SettingsForm
    {
        public string Title { get; set; } = "";
        public string Location { get; set; } = "";
        public string Description { get; set; } = "";
        public PairingSystem PairingSystem { get; set; }
        public int GameTimeMinutes { get; set; }
        public int IncrementSeconds { get; set; }
        public double PointsForWin { get; set; }
        public double PointsForDraw { get; set; }
        public double PointsForLoss { get; set; }
        public double PointsForBye { get; set; }
        public double PointsForAbsence { get; set; }
        public int Boards { get; set; }
        public bool IsRated { get; set; }

        public static SettingsForm From(TournamentDto t) => new()
        {
            Title = t.Title,
            Location = t.Location ?? "",
            Description = t.Description ?? "",
            PairingSystem = t.Settings.PairingSystem,
            GameTimeMinutes = t.Settings.GameTimeMinutes,
            IncrementSeconds = t.Settings.IncrementSeconds,
            PointsForWin = t.Settings.PointsForWin,
            PointsForDraw = t.Settings.PointsForDraw,
            PointsForLoss = t.Settings.PointsForLoss,
            PointsForBye = t.Settings.PointsForBye,
            PointsForAbsence = t.Settings.PointsForAbsence,
            Boards = t.Settings.Boards,
            IsRated = t.Settings.IsRated
        };

        public UpdateTournamentRequest ToRequest() => new(
            Title,
            new TournamentSettingsDto(PairingSystem, GameTimeMinutes, IncrementSeconds,
                PointsForWin, PointsForDraw, PointsForLoss, PointsForBye, Boards, IsRated, PointsForAbsence),
            NullIfEmpty(Location),
            NullIfEmpty(Description));

        private static string? NullIfEmpty(string text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
    }
}
