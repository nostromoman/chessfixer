@page "/tournament/{Id:int}/dashboard"
@inherits TournamentPageBase

<PageTitle>@L["Dashboard"] · @(Tournament?.Title)</PageTitle>

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (IsNotFound || Tournament is null)
{
    <MudAlert Severity="Severity.Warning">@L["TournamentNotFound"]</MudAlert>
}
else
{
    <TournamentHeader Tournament="Tournament" Current="TournamentHeader.Page.Dashboard" />

    <MudGrid>
        <MudItem xs="12" lg="7">
            @switch (Tournament.State)
            {
                case TournamentState.RoundActive when CurrentRound is not null:
                    <MudPaper Class="pa-4" Elevation="1">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <MudText Typo="Typo.h5">@L["Round", CurrentRound.Number]</MudText>
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                                @L["ResultsEntered", ResultsEntered(CurrentRound), CurrentRound.Games.Count(g => g.Black is not null)]
                            </MudText>
                        </div>
                        <GamesTable Round="CurrentRound" Editable="true" Disabled="IsBusy" Large="true" OnResult="SetResultAsync" />
                    </MudPaper>
                    break;

                case TournamentState.New or TournamentState.WaitingForNextRound:
                    <MudPaper Class="pa-4 mb-4" Elevation="1">
                        @if (PendingRound is not null)
                        {
                            <MudText Typo="Typo.h5" Class="mb-2">@L["PairingRound", PendingRound.Number]</MudText>
                            <GamesTable Round="PendingRound" Large="true" />
                        }
                        else if (AllRoundsPlayed)
                        {
                            <MudAlert Severity="Severity.Info">@L["AllRoundsPlayedInfo"]</MudAlert>
                        }
                        else if (Tournament.State == TournamentState.New)
                        {
                            <MudAlert Severity="Severity.Info">@L["NoPairingYet"]</MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning">@L["NoPairingPossible"]</MudAlert>
                        }
                    </MudPaper>

                    @if (CurrentRound is not null)
                    {
                        @* Results of the round just finished; can still be corrected. *@
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-2">@L["ResultsRound", CurrentRound.Number]</MudText>
                            <GamesTable Round="CurrentRound" Editable="true" Disabled="IsBusy" OnResult="SetResultAsync" />
                        </MudPaper>
                    }
                    break;

                default:
                    @if (CurrentRound is not null)
                    {
                        <MudPaper Class="pa-4" Elevation="1">
                            <MudText Typo="Typo.h6" Class="mb-2">@L["ResultsRound", CurrentRound.Number]</MudText>
                            <GamesTable Round="CurrentRound" />
                        </MudPaper>
                    }
                    break;
            }
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h5" Class="mb-2">@L["Standings"]</MudText>
                <StandingsTable Standings="_standings" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private List<RoundDto> _rounds = [];
    private List<StandingDto> _standings = [];

    /// <summary>The most recent started round (active, or just finished).</summary>
    private RoundDto? CurrentRound => _rounds.LastOrDefault(r => r.IsStarted);

    /// <summary>The next round, already paired but not started.</summary>
    private RoundDto? PendingRound => _rounds.FirstOrDefault(r => !r.IsStarted);

    protected override async Task LoadDataAsync()
    {
        var rounds = Api.GetRoundsAsync(Id);
        var standings = Api.GetStandingsAsync(Id);
        _rounds = await rounds;
        _standings = await standings;
    }

    private static int ResultsEntered(RoundDto round) =>
        round.Games.Count(g => g.Black is not null && g.Result != GameResult.NotPlayed);

    private Task SetResultAsync((GameDto Game, GameResult Result) change) =>
        RunAsync(() => Api.SetResultAsync(Id, change.Game.Id, change.Result));
}
