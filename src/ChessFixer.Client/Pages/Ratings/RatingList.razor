@page "/rating"
@inject TournamentApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<Strings> L

@* The rating list of the own players (no guests), with the trend of their rating. *@
<PageTitle>@L["RatingList"]</PageTitle>

<div class="d-flex flex-wrap align-center gap-2 mb-4">
    <MudText Typo="Typo.h4">@L["RatingList"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Info" OnClick="ShowInfoAsync">@L["RatingInfo"]</MudButton>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.History" Href="rating-log">@L["RatingLog"]</MudButton>
</div>

<MudPaper Class="pa-2 pa-sm-4" Elevation="1">
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["RatingListIntro"]</MudText>

    @if (_entries is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_entries.Count == 0)
    {
        <MudText Typo="Typo.body2">@L["RatingListEmpty"]</MudText>
    }
    else
    {
        <MudTable T="RatingListEntryDto" Items="_entries" Dense="true" Hover="true" Striped="true" Elevation="0" Breakpoint="Breakpoint.None">
            @* Also a table on a phone (no stacked cards): photo, trend and games are left out there. *@
            <HeaderContent>
                <MudTh Style="width: 3em; text-align: right">#</MudTh>
                <MudTh Class="hide-xs" Style="width: 3em"></MudTh>
                <MudTh><MudTableSortLabel T="RatingListEntryDto" SortBy="e => e.Name">@L["Name"]</MudTableSortLabel></MudTh>
                <MudTh Style="text-align: right">
                    <MudTableSortLabel T="RatingListEntryDto" SortBy="e => e.Rating" InitialDirection="SortDirection.Descending">@L["Rating"]</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align: right">
                    <MudTableSortLabel T="RatingListEntryDto" SortBy="e => e.Change30Days">@L["RatingChange30Days"]</MudTableSortLabel>
                </MudTh>
                <MudTh Class="hide-xs">@L["RatingTrend"]</MudTh>
                <MudTh Class="hide-xs" Style="text-align: right">
                    <MudTableSortLabel T="RatingListEntryDto" SortBy="e => e.RatedGames">@L["RatingGames"]</MudTableSortLabel>
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="text-align: right" Class="mud-text-secondary">@(_ranks.GetValueOrDefault(context.PlayerId))</MudTd>
                <MudTd Class="hide-xs"><PlayerAvatar FirstName="@context.FirstName" LastName="@context.LastName" PhotoUrl="@context.PhotoUrl" /></MudTd>
                <MudTd DataLabel="@L["Name"]">
                    <MudLink OnClick="() => OpenPlayer(context.PlayerId)">@context.Name</MudLink>
                </MudTd>
                <MudTd DataLabel="@L["Rating"]" Style="text-align: right"><b>@context.Rating</b></MudTd>
                <MudTd DataLabel="@L["RatingChange30Days"]" Style="text-align: right; white-space: nowrap">
                    <span class="@ChangeClass(context.Change30Days)">
                        <MudIcon Icon="@TrendIcon(context.Change30Days)" Size="Size.Small" Style="vertical-align: middle" />
                        @Signed(context.Change30Days)
                    </span>
                </MudTd>
                <MudTd DataLabel="@L["RatingTrend"]" Class="hide-xs"><RatingSparkline Values="context.Trend" /></MudTd>
                <MudTd DataLabel="@L["RatingGames"]" Class="hide-xs" Style="text-align: right">@context.RatedGames</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

<PlayerEditDrawer @ref="_editor" OnSaved="_ => LoadAsync()" />

@code {
    private List<RatingListEntryDto>? _entries;
    private Dictionary<int, int> _ranks = [];
    private PlayerEditDrawer? _editor;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _entries = await Api.GetRatingListAsync();
            // The rank stays the rank by rating, also when the table is sorted otherwise.
            _ranks = _entries.Select((e, i) => (e.PlayerId, Rank: i + 1)).ToDictionary(x => x.PlayerId, x => x.Rank);
        }
        catch (ApiClientException e)
        {
            Snackbar.Add(e.Code is { } code ? L[$"Error_{code}"] : L["Error_Unknown"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["Error_ServerUnavailable"], Severity.Error);
        }
    }

    private async Task OpenPlayer(int playerId)
    {
        try
        {
            var player = (await Api.GetPlayersAsync()).FirstOrDefault(p => p.Id == playerId);
            if (player is not null) _editor?.OpenEdit(player, PlayerEditDrawer.RatingTab);
        }
        catch (Exception)
        {
            Snackbar.Add(L["Error_ServerUnavailable"], Severity.Error);
        }
    }

    private Task ShowInfoAsync() =>
        Dialogs.ShowAsync<RatingInfoDialog>(L["RatingInfoTitle"],
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });

    private static string Signed(int change) => change > 0 ? $"+{change}" : change.ToString();

    private static string? ChangeClass(int change) =>
        change > 0 ? "outcome-win" : change < 0 ? "outcome-loss" : "mud-text-secondary";

    private static string TrendIcon(int change) =>
        change > 0 ? Icons.Material.Filled.TrendingUp
        : change < 0 ? Icons.Material.Filled.TrendingDown
        : Icons.Material.Filled.TrendingFlat;
}
