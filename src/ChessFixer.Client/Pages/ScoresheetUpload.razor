@page "/foto/{Token}"
@layout LoginLayout
@attribute [AllowAnonymous]
@inject TournamentApi Api
@inject IStringLocalizer<Strings> L
@inject ISnackbar Snackbar

@* The page behind the QR code of the scoresheet wizard, opened on a phone: no login (the token in the link is the
   key), only to take one photo of the scoresheet and send it. Opening it tells the wizard that it waits for the photo. *@
<PageTitle>@L["PhoneUploadTitle"] – @L["AppTitle"]</PageTitle>

<MudPaper Elevation="3" Class="pa-6" Style="width: 100%; max-width: 30em">
    <div class="d-flex align-center gap-2 mb-4">
        <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h6">@L["PhoneUploadTitle"]</MudText>
    </div>

    @if (_info is null && _error is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_sent)
    {
        <MudAlert Severity="Severity.Success">@L["PhoneUploadSent"]</MudAlert>
    }
    else if (_info is { } info)
    {
        <MudText Typo="Typo.subtitle1"><b>@info.White</b> – <b>@info.Black</b></MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            @info.Tournament · @L["WizardQrValidUntil", info.ExpiresAt.ToLocalTime().ToString("HH:mm")]
        </MudText>

        @if (_busy)
        {
            @if (_photoUrl is not null)
            {
                <img class="wizard-preview mb-3" src="@_photoUrl" alt="@L["ScoresheetPhotos"]" />
            }
            <MudText Typo="Typo.body2" Class="mb-2">@L["PhoneUploadSending"]</MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4">@L["PhoneUploadHelp"]</MudText>
            <InputFile id="phone-photo" OnChange="PhotoTakenAsync" accept="image/*" capture="environment" hidden />
            <MudButton HtmlTag="label" for="phone-photo" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
                       StartIcon="@Icons.Material.Filled.PhotoCamera">@L["PhoneUploadTake"]</MudButton>
        }
    }
</MudPaper>

@code {
    [Parameter] public string Token { get; set; } = "";

    /// <summary>Scaled down on the phone before sending: plenty to read handwriting.</summary>
    private const int MaxPhotoPixels = 2000;
    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private ScoresheetUploadInfoDto? _info;
    private string? _error;
    private string? _photoUrl;
    private bool _busy;
    private bool _sent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _info = await Api.OpenScoresheetUploadAsync(Token);
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            _error = ErrorText(e);
        }
    }

    /// <summary>The photo is sent right away (the phone's camera already asked to keep it); the computer goes on.</summary>
    private async Task PhotoTakenAsync(InputFileChangeEventArgs e)
    {
        _busy = true;
        try
        {
            var photo = await e.File.RequestImageFileAsync("image/jpeg", MaxPhotoPixels, MaxPhotoPixels);
            await using var stream = photo.OpenReadStream(MaxUploadBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var bytes = buffer.ToArray();
            _photoUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}";
            StateHasChanged();
            await Api.UploadScoresheetViaLinkAsync(Token, bytes, "image/jpeg");
            _sent = true;
        }
        catch (IOException)
        {
            Snackbar.Add(L["Error_InvalidScoresheetImage"], Severity.Error); // try another photo
        }
        catch (ApiClientException ex) when (ex.Code is ApiErrorCode.InvalidScoresheetImage)
        {
            Snackbar.Add(L["Error_InvalidScoresheetImage"], Severity.Error);
        }
        catch (Exception ex) when (ex is ApiClientException or HttpRequestException)
        {
            _error = ErrorText(ex);
        }
        finally
        {
            _busy = false;
            _photoUrl = null;
        }
    }

    private string ErrorText(Exception e) => e switch
    {
        ApiClientException { Code: { } code } => L[$"Error_{code}"],
        ApiClientException => L["Error_Unknown"],
        _ => L["Error_ServerUnavailable"]
    };
}
