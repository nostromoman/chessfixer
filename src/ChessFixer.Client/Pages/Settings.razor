@page "/settings"
@inject IStringLocalizer<Strings> L

@* Application settings, in tabs. (The tournament leaders are managed under Beheer, by the system administrator.) *@
<PageTitle>@L["AppSettings"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["AppSettings"]</MudText>

<MudPaper Elevation="1">
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
        <MudTabPanel Text="@L["AiReportSettings"]" Icon="@Icons.Material.Filled.AutoAwesome">
            <AiSettingsTab />
        </MudTabPanel>
        <MudTabPanel Text="@L["Clubs"]" Icon="@Icons.Material.Filled.Groups">
            <ClubsTab />
        </MudTabPanel>
    </MudTabs>
</MudPaper>
