@page "/help"
@inject IStringLocalizer<Strings> L

@* A short manual. Each section's text is in Strings.resx (Help_{Section}_Body); every line is one bullet. *@
<PageTitle>@L["Help"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["Help"]</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudText Typo="Typo.body1">@L["HelpIntro"]</MudText>
</MudPaper>

<MudExpansionPanels MultiExpansion="true" Elevation="1">
    @foreach (var (key, icon, href) in Sections)
    {
        <MudExpansionPanel Expanded="@(key == "Start")">
            <TitleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@icon" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">@L[$"Help_{key}_Title"]</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <ul class="help-list">
                    @foreach (var line in L[$"Help_{key}_Body"].Value.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <li><MudText Typo="Typo.body2">@line</MudText></li>
                    }
                </ul>
                @if (href is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="@href"
                               EndIcon="@Icons.Material.Filled.ChevronRight" Class="mt-2">
                        @L["HelpOpenPage"]
                    </MudButton>
                }
            </ChildContent>
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    private static readonly (string Key, string Icon, string? Href)[] Sections =
    [
        ("Start", Icons.Material.Filled.EmojiEvents, "tournament"),
        ("Players", Icons.Material.Filled.People, "players"),
        ("Rounds", Icons.Material.Filled.GridOn, null),
        ("Standings", Icons.Material.Filled.FormatListNumbered, null),
        ("Rating", Icons.Material.Filled.Leaderboard, "rating"),
        ("Close", Icons.Material.Filled.AutoStories, "settings"),
        ("Admin", Icons.Material.Filled.AdminPanelSettings, null)
    ];
}
