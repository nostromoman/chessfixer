@page "/games/{GameId:int}/analyse-aanmaken"
@using ChessFixer.Shared.Pgn
@implements IAsyncDisposable
@inject TournamentApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L
@inject NavigationManager Navigation

@* 'Analyse aanmaken': the moves of a played game, entered in one of three ways, that all end on the digital chess board
   (MoveReview, filling the screen: photo, board and moves side by side) where the user checks the moves before going
   on to the analysis:
   1. a photo of the scoresheet (uploaded, taken with the webcam, or with a phone via a QR code): Claude reads it and the
      board starts with the moves read, to check against the photo. With the QR code the phone does everything else;
      this page goes back as soon as the phone opened the page, so the computer is free again.
   2. replaying the game on the board: the board starts empty.
   3. pasted PGN: the board starts with its moves; a move that is not possible shows in red.
   The work on a photo is kept on the server, so the user can continue later. At the end the moves are saved (and
   analysed) and the analysis page opens. *@
<PageTitle>@L["PgnAddMoves"] – @L["AppTitle"]</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" />

<div class="create-analysis @(_stage == Stage.Board ? "on-board" : "")">
    <div class="create-analysis-header">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="Leave" aria-label="@L["Cancel"]" />
        <div class="create-analysis-title">
            <MudText Typo="Typo.h5">@L["PgnAddMoves"]</MudText>
            @if (_game is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_game.White.Name – @(_game.Black?.Name)</MudText>
            }
        </div>
        <div class="wizard-steps">
            @{ var steps = Steps; }
            @for (var i = 0; i < steps.Count; i++)
            {
                @StepLabel(i, steps)
            }
        </div>
        <MudSpacer />
        <div class="create-analysis-actions">
            @if (_stage is Stage.Photo or Stage.Pgn || (_stage == Stage.Board && _method == Method.Board))
            {
                <MudButton StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="BackToChoiceAsync" Disabled="_busy">@L["WizardOtherMethod"]</MudButton>
            }
            else if (_stage == Stage.Board && _method == Method.Pgn)
            {
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="() => _stage = Stage.Pgn">@L["WizardBackToPgn"]</MudButton>
            }
            @if (_stage == Stage.Board && _review is not null)
            {
                <MudText Typo="Typo.body2" Class="@(_review.CanSave ? "mud-success-text" : _review.HasIllegal ? "mud-error-text" : "mud-text-secondary")">@_review.SaveHint</MudText>
            }
            @if (_stage == Stage.Pgn)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="@(!PgnValid)" OnClick="PgnToBoard">@L["WizardToBoard"]</MudButton>
            }
            @if (_stage == Stage.Board)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.QueryStats"
                           Disabled="@(_review is not { CanSave: true } || _busy)" OnClick="SaveAsync">@L["WizardSave"]</MudButton>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Warning">@_error</MudAlert>
    }
    else if (_game is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_stage == Stage.Board)
    {
        <MoveReview @key="_boardKey" @ref="_review" Review="_startReview"
                    PhotoUrl="@(_wizard is null ? null : TournamentApi.ScoresheetImageUrl(_wizard.GameId, _wizard.PhotoId))"
                    OnChange="ScheduleSave" />
    }
    else
    {
        <MudPaper Outlined="true" Class="create-analysis-panel">
            @switch (_stage)
            {
                case Stage.Choose:
                    @ChooseStage
                    break;
                case Stage.Photo:
                    @PhotoStage
                    break;
                case Stage.Read:
                    @ReadStage
                    break;
                case Stage.Pgn:
                    @PgnStage
                    break;
            }
        </MudPaper>
    }
</div>

@code {
    [Parameter] public int GameId { get; set; }

    /// <summary>The tournament of the game: the moves are saved there.</summary>
    [SupplyParameterFromQuery(Name = "toernooi")] public int TournamentId { get; set; }

    /// <summary>Where the user came from: back there when they cancel.</summary>
    [SupplyParameterFromQuery(Name = "terug")] public string? ReturnUrl { get; set; }

    /// <summary>The address of this page for a game.</summary>
    public static string Url(int tournamentId, int gameId, string? returnUrl = null) =>
        $"games/{gameId}/analyse-aanmaken?toernooi={tournamentId}"
        + (string.IsNullOrEmpty(returnUrl) ? "" : $"&terug={Uri.EscapeDataString(returnUrl)}");

    /// <summary>Photos are scaled down to this size before uploading: plenty to read handwriting.</summary>
    private const int MaxPhotoPixels = 2000;
    private const long MaxUploadBytes = 5 * 1024 * 1024;

    private enum Method { None, Photo, Board, Pgn }
    private enum Stage { Choose, Photo, Read, Pgn, Board }

    private GameDto? _game;
    private string? _error;
    private Method _method;
    private Stage _stage = Stage.Choose;
    private bool _busy;
    private bool _disposed;

    /// <summary>Leaving without asking (after saving, or when the phone took over).</summary>
    private bool _leaving;

    /// <summary>The work on a photo, kept on the server; null for the other methods.</summary>
    private ScoresheetWizardDto? _wizard;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rounds = await Api.GetRoundsAsync(TournamentId);
            _game = rounds.SelectMany(r => r.Games).FirstOrDefault(g => g.Id == GameId);
            if (_game is null)
            {
                _error = L["Error_GameNotFound"];
                return;
            }
            if (_game.HasPgn)
            {
                // Already done (e.g. on a phone): show the analysis.
                _leaving = true;
                Navigation.NavigateTo($"games/{GameId}", replace: true);
                return;
            }
            _wizard = await Api.GetScoresheetWizardAsync(GameId);
        }
        catch (ApiClientException e) when (e.Code is ApiErrorCode.TournamentNotFound or ApiErrorCode.GameNotFound)
        {
            _error = L["Error_GameNotFound"];
            return;
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            _error = L["Error_ServerUnavailable"];
            return;
        }

        // Continue the work on a photo.
        if (_wizard is null) return;
        _method = Method.Photo;
        if (_wizard.Review is { } review) ToBoard(review);
        else _stage = Stage.Read;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Continued while Claude is still reading: wait for it.
        if (firstRender && _wizard is { ReadStatus: ScoresheetReadStatus.Reading }) await PollAsync();
    }

    /// <summary>Back to where the user came from (only an address within the app).</summary>
    private void Leave() =>
        Navigation.NavigateTo(ReturnUrl is { Length: > 0 } url && Uri.IsWellFormedUriString(url, UriKind.Relative)
                              && !url.Contains(':') && !url.StartsWith('/') ? url : "games");

    /// <summary>Moves played on the board or pasted are only kept when saved: ask before leaving them.</summary>
    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (_leaving || _wizard is not null || _stage != Stage.Board || _review is not { MoveCount: > 0 }) return;
        if (!await ConfirmDropAsync()) context.PreventNavigation();
    }

    private async Task<bool> ConfirmDropAsync() =>
        await Dialogs.ShowMessageBoxAsync(L["PgnAddMoves"], L["WizardCloseUnsaved"], yesText: L["WizardDiscard"], cancelText: L["Cancel"]) == true;

    // ----- The steps at the top: they depend on the method -----

    private List<(Stage Stage, string Label)> Steps
    {
        get
        {
            var steps = new List<(Stage, string)> { (Stage.Choose, L["WizardStepMethod"]) };
            switch (_method)
            {
                case Method.Photo:
                    steps.Add((Stage.Photo, L["WizardStepPhoto"]));
                    steps.Add((Stage.Read, L["WizardStepRead"]));
                    break;
                case Method.Pgn:
                    steps.Add((Stage.Pgn, L["WizardStepPgn"]));
                    break;
                case Method.None:
                    steps.Add((Stage.Photo, L["WizardStepInput"]));
                    break;
            }
            steps.Add((Stage.Board, L["WizardStepBoard"]));
            return steps;
        }
    }

    private RenderFragment StepLabel(int index, List<(Stage Stage, string Label)> steps) => __builder =>
    {
        var current = steps.FindIndex(s => s.Stage == _stage);
        var css = "wizard-step" + (index == current ? " active" : index < current ? " done" : "");
        <div class="@css">
            <span class="wizard-step-number">
                @if (index < current)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Check" Style="font-size: 16px" />
                }
                else
                {
                    @(index + 1)
                }
            </span>
            <span>@steps[index].Label</span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
        </div>
        @if (index == steps.Count - 1)
        {
            <div class="wizard-step">
                <MudIcon Icon="@Icons.Material.Filled.QueryStats" Size="Size.Small" />
                <span>@L["WizardStepAnalysis"]</span>
            </div>
        }
    };

    // ----- Step 1: the method -----

    private RenderFragment ChooseStage => __builder =>
    {
        <div>
            <MudText Typo="Typo.body1" Class="mb-4">@L["WizardChooseIntro"]</MudText>
            <div class="wizard-methods">
                @MethodCard(Icons.Material.Filled.DocumentScanner, L["WizardMethodPhoto"], L["WizardMethodPhotoHelp"], ChoosePhotoAsync)
                @MethodCard(Icons.Material.Filled.Grid4x4, L["WizardMethodBoard"], L["WizardMethodBoardHelp"], ChooseBoard)
                @MethodCard(Icons.Material.Filled.ContentPaste, L["WizardMethodPgn"], L["WizardMethodPgnHelp"], ChoosePgn)
            </div>
        </div>
    };

    private RenderFragment MethodCard(string icon, string title, string help, Func<Task> choose) => __builder =>
    {
        <button type="button" class="wizard-method" @onclick="choose" disabled="@_busy">
            <MudIcon Icon="@icon" Color="Color.Primary" Style="font-size: 48px" />
            <span class="wizard-method-title">@title</span>
            <span class="wizard-method-help">@help</span>
        </button>
    };

    private async Task ChoosePhotoAsync()
    {
        _method = Method.Photo;
        _stage = Stage.Photo;
        StateHasChanged();
        await StartLinkAsync();
    }

    private Task ChooseBoard()
    {
        _method = Method.Board;
        ToBoard(new ScoresheetReviewDto([]));
        return Task.CompletedTask;
    }

    private Task ChoosePgn()
    {
        _method = Method.Pgn;
        _stage = Stage.Pgn;
        return Task.CompletedTask;
    }

    /// <summary>Back to the three methods; moves played on the board are dropped (after asking).</summary>
    private async Task BackToChoiceAsync()
    {
        if (_stage == Stage.Board && _review is { MoveCount: > 0 } && !await ConfirmDropAsync()) return;
        await CancelLinkAsync();
        _photo = null;
        _photoUrl = null;
        _review = null;
        _method = Method.None;
        _stage = Stage.Choose;
    }

    // ----- Method 1: a photo (this computer, the webcam, or a phone via the QR code) -----

    private readonly string _fileInputId = $"wizard-photo-{Guid.NewGuid():N}";
    private byte[]? _photo;
    private string? _photoUrl;

    private RenderFragment PhotoStage => __builder =>
    {
        <div>
        @if (_photo is null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4 text-center">@L["WizardPhotoHelp"]</MudText>
            <div class="wizard-photo-sources">
                <div class="wizard-source-buttons">
                    <InputFile id="@_fileInputId" OnChange="PhotoChosenAsync" accept="image/*" hidden disabled="@_busy" />
                    <MudButton HtmlTag="label" for="@_fileInputId" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Upload" Disabled="_busy">@L["WizardChoosePhoto"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Videocam" OnClick="TakePhotoAsync" Disabled="_busy">@L["WizardTakePhoto"]</MudButton>
                </div>
                @if (_busy)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                <div class="wizard-or"><span>@L["WizardOr"]</span></div>
                @PhoneLink
            </div>
        }
        else
        {
            <div class="wizard-preview-box">
                <img class="wizard-preview" src="@_photoUrl" alt="@L["ScoresheetPhotos"]" />
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary d-block mt-3 mb-2 text-center">@L["WizardPhotoCheck"]</MudText>
            <div class="d-flex flex-wrap gap-2 justify-center">
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Replay" OnClick="OtherPhotoAsync" Disabled="_busy">
                    @L["WizardOtherPhoto"]
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="UploadAndReadAsync" Disabled="_busy">@L["WizardRead"]</MudButton>
            </div>
        }
        </div>
    };

    /// <summary>A photo was chosen: scaled down in the browser.</summary>
    private async Task PhotoChosenAsync(InputFileChangeEventArgs e)
    {
        _busy = true;
        try
        {
            var photo = await e.File.RequestImageFileAsync("image/jpeg", MaxPhotoPixels, MaxPhotoPixels);
            await using var stream = photo.OpenReadStream(MaxUploadBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            SetPhoto(buffer.ToArray());
        }
        catch (IOException)
        {
            Snackbar.Add(L["Error_InvalidScoresheetImage"], Severity.Error); // still too large after scaling
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TakePhotoAsync()
    {
        var dialog = await Dialogs.ShowAsync<WebcamDialog>(L["WizardTakePhoto"],
            new DialogParameters<WebcamDialog> { { d => d.Size, MaxPhotoPixels }, { d => d.Document, true } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true });
        if (await dialog.Result is { Canceled: false, Data: byte[] photo }) SetPhoto(photo);
    }

    private void SetPhoto(byte[] photo)
    {
        _photo = photo;
        _photoUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(photo)}";
        _ = CancelLinkAsync(); // a photo on this computer: the phone is no longer needed
    }

    private async Task OtherPhotoAsync()
    {
        _photo = null;
        _photoUrl = null;
        if (!LinkUsable) await StartLinkAsync();
    }

    // ----- The QR code: the phone does the rest -----

    private ScoresheetLinkDto? _link;
    private string? _qrSvg;

    private bool LinkUsable => _link is { Status: ScoresheetLinkStatus.Waiting };

    /// <summary>The phone cannot reach the server by this name (it is this computer).</summary>
    private bool LocalAddress => new Uri(Navigation.BaseUri).Host is "localhost" or "127.0.0.1" or "[::1]";

    private RenderFragment PhoneLink => __builder =>
    {
        <div class="wizard-qr">
            <div class="d-flex align-center justify-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1"><b>@L["WizardQrTitle"]</b></MudText>
            </div>
            @if (_link is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="my-6" />
            }
            else if (_link.Status == ScoresheetLinkStatus.Waiting)
            {
                <div class="wizard-qr-code">@((MarkupString)(_qrSvg ?? ""))</div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["WizardQrHelp"]</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                    @L["WizardQrValidUntil", _link.ExpiresAt.ToLocalTime().ToString("HH:mm")]
                </MudText>
                @if (LocalAddress)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@L["WizardQrLocalhost", Navigation.BaseUri]</MudAlert>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary my-4">
                    @(_link.Status == ScoresheetLinkStatus.Expired ? L["WizardQrExpired"] : L["WizardQrCancelled"])
                </MudText>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.QrCode2"
                           OnClick="StartLinkAsync">@L["WizardQrNew"]</MudButton>
            }
        </div>
    };

    /// <summary>A new QR code (valid 20 minutes); watched until a phone opens it.</summary>
    private async Task StartLinkAsync()
    {
        if (_disposed || _stage != Stage.Photo) return;
        try
        {
            var link = await Api.CreateScoresheetLinkAsync(GameId);
            _link = link;
            _qrSvg = QrCode.Svg(Navigation.ToAbsoluteUri($"foto/{link.Token}").ToString());
            StateHasChanged();
            _ = WatchLinkAsync(link.Id);
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            _link = null; // no QR code; the other ways still work
        }
    }

    /// <summary>
    /// Checks every 2 seconds whether a phone opened the page. Then the phone does the rest and this page goes back,
    /// so the computer is free for the next game.
    /// </summary>
    private async Task WatchLinkAsync(int linkId)
    {
        while (!_disposed && _link?.Id == linkId && LinkUsable)
        {
            await Task.Delay(2000);
            if (_disposed || _link?.Id != linkId || !LinkUsable) return;
            try
            {
                var link = await Api.GetScoresheetLinkAsync(GameId, linkId);
                if (_disposed || _link?.Id != linkId) return;
                _link = link;
                if (link.Status is ScoresheetLinkStatus.Opened or ScoresheetLinkStatus.Uploaded)
                {
                    Snackbar.Add(L["WizardQrHandedOver", _game?.White.Name ?? "", _game?.Black?.Name ?? ""], Severity.Info);
                    _leaving = true;
                    Leave();
                    return;
                }
                StateHasChanged();
            }
            catch (Exception e) when (e is ApiClientException or HttpRequestException)
            {
                // Try again at the next tick.
            }
        }
    }

    /// <summary>The QR code can no longer be used (the server ignores this once a phone opened it).</summary>
    private async Task CancelLinkAsync()
    {
        if (_link is not { Status: ScoresheetLinkStatus.Waiting } link) return;
        _link = link with { Status = ScoresheetLinkStatus.Cancelled };
        try
        {
            await Api.CancelScoresheetLinkAsync(GameId, link.Id);
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            // It expires by itself within 20 minutes.
        }
    }

    /// <summary>Keeps the photo with the game and lets Claude read it.</summary>
    private async Task UploadAndReadAsync()
    {
        if (_photo is null) return;
        _busy = true;
        try
        {
            var uploaded = await Api.UploadScoresheetAsync(GameId, _photo, "image/jpeg");
            _ = CancelLinkAsync();
            _wizard = new ScoresheetWizardDto(uploaded.Id, GameId, uploaded.UploadedAt, ScoresheetReadStatus.Reading, null, null, "", null);
            _stage = Stage.Read;
            _busy = false;
            StateHasChanged();
            await ReadAsync();
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            ShowError(e);
        }
        finally
        {
            _busy = false;
        }
    }

    // ----- Claude reads the photo -----

    /// <summary>Set when reading is not possible at all (no Claude): the photo is kept.</summary>
    private string? _readError;

    private RenderFragment ReadStage => __builder =>
    {
        <div>
        @if (_readError is not null || _wizard is { ReadStatus: ScoresheetReadStatus.Failed })
        {
            @* Reading the same photo again does not help: another photo, or replaying the game next to this one. *@
            <MudAlert Severity="Severity.Error" Class="mb-3">
                @(_readError ?? $"{L["WizardReadFailed"]} {_wizard?.ReadError}")
            </MudAlert>
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Replay"
                           OnClick="AnotherPhotoAsync" Disabled="_busy">@L["WizardOtherPhoto"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Grid4x4"
                           OnClick="ReplayNextToPhotoAsync" Disabled="_busy">@L["WizardTypeMoves"]</MudButton>
            </div>
        }
        else if (_wizard is not null)
        {
            <div class="d-flex flex-wrap gap-4 align-start">
                <img class="wizard-preview" style="max-width: 280px; max-height: 360px; margin: 0"
                     src="@TournamentApi.ScoresheetImageUrl(_wizard.GameId, _wizard.PhotoId)" alt="@L["ScoresheetPhotos"]" />
                <div style="flex: 1; min-width: 240px">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["WizardReading"]</MudText>
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["WizardReadingHelp"]</MudText>
                </div>
            </div>
        }
        </div>
    };

    private async Task ReadAsync()
    {
        if (_wizard is null) return;
        _busy = true;
        _wizard = _wizard with { ReadStatus = ScoresheetReadStatus.Reading, ReadError = null };
        StateHasChanged();
        try
        {
            var wizard = await Api.ReadScoresheetPhotoAsync(_wizard.GameId, _wizard.PhotoId);
            if (_disposed) return; // left meanwhile: the result is kept on the server
            _wizard = wizard;
            if (wizard.ReadStatus == ScoresheetReadStatus.Reading) await PollAsync(); // already being read elsewhere
            else if (wizard.Review is { } review) ToBoard(review);
        }
        catch (ApiClientException e) when (e.Code is ApiErrorCode.ScoresheetNeedsClaude)
        {
            _readError = $"{L["Error_ScoresheetNeedsClaude"]} {L["ScoresheetStoredAnyway"]}";
        }
        catch (TaskCanceledException)
        {
            // The browser gave up waiting; the server goes on reading.
            await PollAsync();
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            ShowError(e);
            _wizard = _wizard with { ReadStatus = ScoresheetReadStatus.Failed, ReadError = null };
        }
        finally
        {
            _busy = false;
        }
        if (!_disposed) StateHasChanged();
    }

    /// <summary>Waits until the server has read the photo (the reading was started earlier).</summary>
    private async Task PollAsync()
    {
        while (!_disposed && _wizard is { ReadStatus: ScoresheetReadStatus.Reading })
        {
            await Task.Delay(3000);
            if (_disposed) return;
            try
            {
                var wizard = await Api.GetScoresheetWizardAsync(GameId);
                if (wizard is null || wizard.PhotoId != _wizard.PhotoId)
                {
                    // Finished or started over elsewhere.
                    _leaving = true;
                    Leave();
                    return;
                }
                _wizard = wizard;
                if (wizard.Review is { } review && wizard.ReadStatus != ScoresheetReadStatus.Reading)
                {
                    ToBoard(review);
                    StateHasChanged();
                    return;
                }
                StateHasChanged();
            }
            catch (Exception e) when (e is ApiClientException or HttpRequestException)
            {
                // Try again at the next tick.
            }
        }
    }

    /// <summary>The photo could not be read: the work on it is closed (the photo is kept) to try another photo.</summary>
    private async Task AnotherPhotoAsync()
    {
        _busy = true;
        try
        {
            await Api.CloseScoresheetWizardAsync(GameId);
            _wizard = null;
            _readError = null;
            _photo = null;
            _photoUrl = null;
            _link = null;
            _stage = Stage.Photo;
            await StartLinkAsync();
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            ShowError(e);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Reading failed: the user replays the game on the board next to the photo.</summary>
    private async Task ReplayNextToPhotoAsync()
    {
        _readError = null;
        ToBoard(new ScoresheetReviewDto([]));
        await SaveReviewAsync();
    }

    // ----- Method 3: pasted PGN -----

    private string? _pgnText;

    private const string PgnPlaceholder = "[White \"...\"]\n[Black \"...\"]\n\n1. e4 e5 2. Nf3 Nc6 3. Bc4 Bc5 ...";

    private string? PgnNormalized => PgnText.Normalize(_pgnText);

    private bool PgnValid => PgnNormalized is { } text && text.Length <= PgnText.MaxLength && PgnText.HasMoves(text);

    private string? PgnError => PgnNormalized is null || PgnValid ? null : L["PgnNoMoves"].Value;

    private RenderFragment PgnStage => __builder =>
    {
        <div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["WizardPastePgnHelp"]</MudText>
            <MudTextField T="string" @bind-Value="_pgnText" Variant="Variant.Outlined" Lines="14" Immediate="true" AutoFocus="true"
                          MaxLength="PgnText.MaxLength" Class="pgn-text" Placeholder="@PgnPlaceholder"
                          Error="@(PgnError is not null)" ErrorText="@PgnError" />
        </div>
    };

    /// <summary>The moves of the PGN on the board, as written: the board shows which are not possible.</summary>
    private void PgnToBoard()
    {
        if (PgnNormalized is not { } text || !PgnValid) return;
        var moves = PgnText.MoveTokens(text)
            .Select(m => new ScoresheetReviewMoveDto(m, "", [], MoveConfidence.Low, true))
            .ToList();
        ToBoard(new ScoresheetReviewDto(moves));
    }

    // ----- The digital chess board: check the moves, then on to the analysis -----

    private MoveReview? _review;
    private ScoresheetReviewDto _startReview = new([]);

    /// <summary>Each start of the board gets a new MoveReview (it reads its moves only when it starts).</summary>
    private int _boardKey;

    private void ToBoard(ScoresheetReviewDto review)
    {
        _startReview = review;
        _boardKey++;
        _stage = Stage.Board;
    }

    // ----- Saving: the work on a photo (to continue later), and at the end the moves -----

    private CancellationTokenSource? _saveDelay;
    private bool _dirty;

    /// <summary>Saves the work on a photo a moment after the last change (not on every key press).</summary>
    private void ScheduleSave()
    {
        if (_wizard is null) return; // played on the board or pasted: kept only when saved
        _dirty = true;
        _saveDelay?.Cancel();
        _saveDelay = new CancellationTokenSource();
        _ = SaveLaterAsync(_saveDelay.Token);
    }

    private async Task SaveLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(1000, token);
        }
        catch (TaskCanceledException)
        {
            return; // a newer change saves
        }
        await SaveReviewAsync();
    }

    private async Task SaveReviewAsync()
    {
        if (_wizard is null || _stage != Stage.Board) return;
        _dirty = false;
        var review = _review?.Current ?? _startReview;
        try
        {
            await Api.SaveScoresheetReviewAsync(_wizard.GameId, _wizard.PhotoId, review);
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            _dirty = true; // tried again with the next change, or when the page is left
        }
    }

    private async Task FlushAsync()
    {
        _saveDelay?.Cancel();
        if (_dirty) await SaveReviewAsync();
    }

    /// <summary>The moves are saved as the game's PGN (which closes the work on a photo and starts the analysis); then
    /// the analysis page opens.</summary>
    private async Task SaveAsync()
    {
        if (_review is not { CanSave: true } review) return;
        _busy = true;
        try
        {
            await FlushAsync();
            var pgn = await Api.BuildScoresheetPgnAsync(GameId, review.Moves, fromPhoto: _wizard is not null);
            await Api.SetPgnAsync(TournamentId, GameId, pgn.Pgn);
            Snackbar.Add(L["PgnSaved"], Severity.Success);
            _leaving = true;
            Navigation.NavigateTo($"games/{GameId}");
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            ShowError(e);
        }
        finally
        {
            _busy = false;
        }
    }

    private void ShowError(Exception e)
    {
        var message = e switch
        {
            ApiClientException { Code: { } code } api => L[$"Error_{code}"].Value + (api.Detail is { } detail ? " " + detail : ""),
            ApiClientException => L["Error_Unknown"].Value,
            _ => L["Error_ServerUnavailable"].Value
        };
        Snackbar.Add(message, Severity.Error);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        // Left: keep the work on a photo; a QR code that no phone opened can no longer be used.
        await FlushAsync();
        await CancelLinkAsync();
        _saveDelay?.Dispose();
    }
}
