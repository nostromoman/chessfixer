@inherits LayoutComponentBase
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject NavigationManager Navigation
@inject ServerAuthenticationStateProvider Auth
@inject IDialogService Dialogs
@inject IBrowserViewportService Viewport
@inject DeviceInfo Device

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _menuOpen = !_menuOpen" aria-label="@L["ToggleMenu"]" />
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="ml-2 mr-2" />
        <MudLink Href="" Color="Color.Inherit" Typo="Typo.h6" Underline="Underline.None" Class="appbar-title">@L["AppTitle"]</MudLink>
        <MudSpacer />

        @* The logged-in user, with a menu to change the password and to log out. *@
        <AuthorizeView Context="auth">
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="@L["Account"]">
                <ActivatorContent>
                    @* Since MudBlazor 9 a custom activator must open the menu itself, via the MenuContext. *@
                    @* On a phone only the icon is shown, the name would push the title off the screen. *@
                    <MudButton Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle" Class="text-none appbar-user"
                               OnClick="e => context.ToggleAsync(e)" aria-label="@L["Account"]">
                        <span class="appbar-user-name">@auth.User.Identity?.Name</span>
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Password" OnClick="ChangePasswordAsync">@L["ChangePassword"]</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">@L["Logout"]</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="1">
        <div class="d-flex flex-column" style="height: 100%">
            <MudNavMenu Class="mt-2 flex-grow-1">
                <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                    @L["Home"]
                </MudNavLink>
                <MudNavLink Href="tournament" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EmojiEvents">
                    @L["Tournaments"]
                </MudNavLink>
                <MudNavLink Href="players" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                    @L["Players"]
                </MudNavLink>
                <MudNavLink Href="rating" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Leaderboard">
                    @L["RatingList"]
                </MudNavLink>
                <MudNavLink Href="rating-log" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">
                    @L["RatingLog"]
                </MudNavLink>

                @* Only for the system administrator; tournament leaders do not see these menu items. *@
                <AuthorizeView Roles="@nameof(UserRole.Admin)">
                    <MudNavGroup Title="@L["Administration"]" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                        <MudNavLink Href="admin/leaders" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ManageAccounts">
                            @L["Leaders"]
                        </MudNavLink>
                        <MudNavLink Href="admin/activity" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Insights">
                            @L["ActivityLog"]
                        </MudNavLink>
                        <MudNavLink Href="admin/development" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Construction">
                            @L["Development"]
                        </MudNavLink>
                    </MudNavGroup>
                </AuthorizeView>
            </MudNavMenu>

            @* Application settings (a gear) at the bottom left of the menu. *@
            <div class="pa-2 d-flex gap-1">
                <MudTooltip Text="@L["AppSettings"]" Placement="Placement.Right">
                    <MudIconButton Icon="@Icons.Material.Filled.Settings" Href="settings" aria-label="@L["AppSettings"]"
                                   Color="@(IsOn("settings") ? Color.Primary : Color.Default)" />
                </MudTooltip>
            </div>
        </div>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="main-container py-4 py-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuOpen = true;

    /// <summary>Below this breakpoint the menu is a temporary drawer over the page (the Responsive drawer's default).</summary>
    private const Breakpoint MenuBreakpoint = Breakpoint.Md;

    private bool IsOn(string page) => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith(page, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    /// <summary>On a phone or tablet the menu starts closed, so the page itself is visible.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Device.InitializeAsync();
        if (firstRender && _menuOpen && await IsSmallScreenAsync())
        {
            _menuOpen = false;
            StateHasChanged();
        }
    }

    /// <summary>On a small screen the menu covers the page: close it after choosing a page.</summary>
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        if (_menuOpen && await IsSmallScreenAsync()) _menuOpen = false;
        StateHasChanged();
    });

    private async Task<bool> IsSmallScreenAsync()
    {
        try
        {
            return await Viewport.GetCurrentBreakpointAsync() < MenuBreakpoint;
        }
        catch (JSException)
        {
            return false;
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private Task ChangePasswordAsync() =>
        Dialogs.ShowAsync<ChangePasswordDialog>(L["ChangePassword"],
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, BackdropClick = false });

    /// <summary>Reloads the app, so nothing of the session (data, live connection) stays in memory.</summary>
    private async Task LogoutAsync()
    {
        try
        {
            await Auth.LogoutAsync();
        }
        catch (HttpRequestException)
        {
            // Server unreachable: the cookie stays, but the app still goes to the login page.
        }
        Navigation.NavigateTo("login", forceLoad: true);
    }
}
