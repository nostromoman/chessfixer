@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> L

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _menuOpen = !_menuOpen" aria-label="@L["ToggleMenu"]" />
        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="ml-2 mr-2" />
        <MudLink Href="tournament" Color="Color.Inherit" Typo="Typo.h6" Underline="Underline.None">@L["AppTitle"]</MudLink>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Elevation="1">
        <MudNavMenu Class="mt-2">
            <MudNavLink Href="tournament" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EmojiEvents">
                @L["Tournaments"]
            </MudNavLink>
            <MudNavLink Href="players" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">
                @L["Players"]
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuOpen = true;
}
