@inject IStringLocalizer<Strings> L

<MudSimpleTable Dense="true" Hover="true" Striped="true">
    <thead>
        <tr>
            <th>@L["Rank"]</th>
            <th>@L["Name"]</th>
            <th style="text-align: right">@L["PointsShort"]</th>
            @if (IsCompetition)
            {
                <th style="text-align: right" title="@L["PercentageLong"]">@L["PercentageShort"]</th>
            }
            else
            {
                <th style="text-align: right" title="@L["BuchholzLong"]">@L["BuchholzShort"]</th>
            }
            <th class="hide-xs" style="text-align: right" title="@L["SonnebornBergerLong"]">@L["SonnebornBergerShort"]</th>
            <th style="text-align: right">@L["PlayedShort"]</th>
            @if (IsCompetition)
            {
                <th style="text-align: right" title="@L["RemainingLong"]">@L["RemainingShort"]</th>
            }
            <th class="hide-xs" style="text-align: right">@L["WinsShort"]</th>
            <th class="hide-xs" style="text-align: right">@L["DrawsShort"]</th>
            <th class="hide-xs" style="text-align: right">@L["LossesShort"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Standings)
        {
            <tr class="@(row.IsActive ? null : "withdrawn")">
                <td>@row.Rank</td>
                <td>
                    @if (OnPlayerClick.HasDelegate)
                    {
                        var playerId = row.PlayerId;
                        <MudLink OnClick="() => OnPlayerClick.InvokeAsync(playerId)"><PlayerName Name="@row.Name" IsDeleted="row.IsDeleted" /></MudLink>
                    }
                    else
                    {
                        <PlayerName Name="@row.Name" IsDeleted="row.IsDeleted" />
                    }
                    @if (!row.IsActive)
                    {
                        <MudText Typo="Typo.caption" Inline="true"> (@L["Withdrawn"].Value.ToLowerInvariant())</MudText>
                    }
                </td>
                <td style="text-align: right"><b>@Display.Points(row.Points)</b></td>
                @if (IsCompetition)
                {
                    <td style="text-align: right">@(row.Percentage is { } percentage ? Display.Points(percentage) : "")</td>
                }
                else
                {
                    <td style="text-align: right">@Display.Points(row.Buchholz)</td>
                }
                <td class="hide-xs" style="text-align: right">@Display.Points(row.SonnebornBerger)</td>
                <td style="text-align: right">@row.Played</td>
                @if (IsCompetition)
                {
                    <td style="text-align: right">@row.Remaining</td>
                }
                <td class="hide-xs" style="text-align: right">@row.Wins</td>
                <td class="hide-xs" style="text-align: right">@row.Draws</td>
                <td class="hide-xs" style="text-align: right">@row.Losses</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StandingDto> Standings { get; set; } = [];

    /// <summary>Competition: percentage and games still to play instead of Buchholz.</summary>
    private bool IsCompetition => Standings.Any(s => s.Remaining is not null);

    /// <summary>When set, player names are links; the callback gets the player id.</summary>
    [Parameter] public EventCallback<int> OnPlayerClick { get; set; }
}
