@inject IStringLocalizer<Strings> L

<MudSimpleTable Dense="true" Hover="true" Striped="true">
    <thead>
        <tr>
            <th>@L["Rank"]</th>
            <th>@L["Name"]</th>
            <th style="text-align: right">@L["PointsShort"]</th>
            <th style="text-align: right" title="@L["BuchholzLong"]">@L["BuchholzShort"]</th>
            <th style="text-align: right" title="@L["SonnebornBergerLong"]">@L["SonnebornBergerShort"]</th>
            <th style="text-align: right">@L["PlayedShort"]</th>
            <th style="text-align: right">@L["WinsShort"]</th>
            <th style="text-align: right">@L["DrawsShort"]</th>
            <th style="text-align: right">@L["LossesShort"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Standings)
        {
            <tr class="@(row.IsActive ? null : "withdrawn")">
                <td>@row.Rank</td>
                <td>
                    @row.Name
                    @if (!row.IsActive)
                    {
                        <MudText Typo="Typo.caption" Inline="true"> (@L["Withdrawn"].Value.ToLowerInvariant())</MudText>
                    }
                </td>
                <td style="text-align: right"><b>@Display.Points(row.Points)</b></td>
                <td style="text-align: right">@Display.Points(row.Buchholz)</td>
                <td style="text-align: right">@Display.Points(row.SonnebornBerger)</td>
                <td style="text-align: right">@row.Played</td>
                <td style="text-align: right">@row.Wins</td>
                <td style="text-align: right">@row.Draws</td>
                <td style="text-align: right">@row.Losses</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<StandingDto> Standings { get; set; } = [];
}
