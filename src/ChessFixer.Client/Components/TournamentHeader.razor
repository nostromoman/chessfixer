@inject IStringLocalizer<Strings> L

@* Title of a tournament, with a red power button that closes the tournament (not shown once it is closed). *@
<div class="d-flex align-start justify-space-between gap-2 mb-4">
    <div style="min-width: 0">
        <MudText Typo="Typo.h4">@Tournament.Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Tournament.Location))
        {
            <div class="d-flex align-center gap-1 mud-text-secondary mt-1">
                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                <MudText Typo="Typo.body2">@Tournament.Location</MudText>
            </div>
        }
    </div>

    @if (Tournament.State != TournamentState.Closed)
    {
        <MudTooltip Text="@(CanClose ? L["CloseTournament"] : L["CloseBlockedInRound"])">
            <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew" Color="Color.Error" aria-label="@L["CloseTournament"]"
                           Disabled="@(!CanClose || Disabled)" OnClick="OnClose" />
        </MudTooltip>
    }
</div>

@code {
    [Parameter, EditorRequired] public TournamentDto Tournament { get; set; } = null!;

    /// <summary>Closing is possible before and between rounds, not during a round.</summary>
    [Parameter] public bool CanClose { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
