@inject IStringLocalizer<Strings> L

@* Title, state and navigation between the pages of one tournament. *@
<div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-4">
    <div>
        <MudText Typo="Typo.h4">@Tournament.Title</MudText>
        <div class="d-flex flex-wrap align-center gap-3 mt-1">
            <MudChip T="string" Size="Size.Small" Color="Display.StateColor(Tournament.State)" Class="ma-0">
                @L[$"State_{Tournament.State}"]
            </MudChip>
            @if (Tournament.RoundsStarted > 0)
            {
                <MudText Typo="Typo.body1">
                    @(Tournament.TotalRounds is { } total
                        ? L["RoundOf", Tournament.RoundsStarted, total]
                        : L["Round", Tournament.RoundsStarted])
                </MudText>
            }
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                @L[$"PairingSystem_{Tournament.Settings.PairingSystem}"] ·
                @L["TimeControl", Tournament.Settings.GameTimeMinutes, Tournament.Settings.IncrementSeconds]
            </MudText>
        </div>
    </div>

    <div class="d-flex gap-2">
        <MudButton Href="@($"tournament/{Tournament.Id}")" StartIcon="@Icons.Material.Filled.Settings"
                   Variant="@VariantFor(Page.Management)" Color="Color.Primary">@L["Management"]</MudButton>
        <MudButton Href="@($"tournament/{Tournament.Id}/players")" StartIcon="@Icons.Material.Filled.People"
                   Variant="@VariantFor(Page.Players)" Color="Color.Primary">@L["Players"]</MudButton>
        <MudButton Href="@($"tournament/{Tournament.Id}/dashboard")" StartIcon="@Icons.Material.Filled.Tv"
                   Variant="@VariantFor(Page.Dashboard)" Color="Color.Primary">@L["Dashboard"]</MudButton>
    </div>
</div>

@code {
    public enum Page { Management, Players, Dashboard }

    [Parameter, EditorRequired] public TournamentDto Tournament { get; set; } = null!;
    [Parameter] public Page Current { get; set; }

    private Variant VariantFor(Page page) => page == Current ? Variant.Filled : Variant.Text;
}
