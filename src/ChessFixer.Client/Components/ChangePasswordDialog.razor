@inject TournamentApi Api
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L

@* Changes the password of the logged-in user. Other sessions of the user are logged out. *@
<MudDialog>
    <DialogContent>
        <form id="change-password" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <div class="d-flex flex-column gap-3">
                <MudTextField @bind-Value="_current" Label="@L["CurrentPassword"]" InputType="InputType.Password"
                              Variant="Variant.Outlined" Immediate="true" AutoFocus="true" Disabled="_busy"
                              autocomplete="current-password" />
                <MudTextField @bind-Value="_new" Label="@L["NewPassword"]" InputType="InputType.Password"
                              HelperText="@L["PasswordHelp", PasswordRules.MinLength]"
                              Variant="Variant.Outlined" Immediate="true" Disabled="_busy" autocomplete="new-password" />
                <MudTextField @bind-Value="_repeat" Label="@L["RepeatPassword"]" InputType="InputType.Password"
                              Error="@RepeatMismatch" ErrorText="@L["PasswordsDiffer"]"
                              Variant="Variant.Outlined" Immediate="true" Disabled="_busy" autocomplete="new-password" />
            </div>
        </form>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()" Disabled="_busy">@L["Cancel"]</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="change-password" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(!CanSave)">@L["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    private string _current = "";
    private string _new = "";
    private string _repeat = "";
    private bool _busy;

    private bool RepeatMismatch => _repeat.Length > 0 && _repeat != _new;

    private bool CanSave => !_busy && _current.Length > 0 && _new.Length >= PasswordRules.MinLength && _repeat == _new;

    private async Task SaveAsync()
    {
        if (!CanSave) return;

        _busy = true;
        try
        {
            await Api.ChangePasswordAsync(_current, _new);
            Snackbar.Add(L["PasswordChanged"], Severity.Success);
            Dialog.Close();
        }
        catch (ApiClientException e)
        {
            Snackbar.Add(e.Code is { } code ? L[$"Error_{code}"] : L["Error_Unknown"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["Error_ServerUnavailable"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
