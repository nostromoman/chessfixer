@using System.Globalization
@inject TournamentApi Api
@inject IStringLocalizer<Strings> L

@* Rating of one player in the player drawer: the current rating, a line chart of every rating change, and every
   rated tournament (a card) with each game and its change. The ratings change when a tournament is closed; the games of a
   running tournament show what they would give if it were closed now. *@
@if (_failed)
{
    <MudAlert Severity="Severity.Error" Dense="true">@L["StatsLoadFailed"]</MudAlert>
}
else if (_rating is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <div class="player-stats-totals mb-2">
        <div class="player-stats-tile">
            <div class="player-stats-value">@_rating.Rating</div>
            <div class="player-stats-label">@L["RatingCurrent"]</div>
        </div>
        @if (_rating.Tournaments.FirstOrDefault(t => !t.IsProcessed) is { } running)
        {
            <div class="player-stats-tile">
                <div class="player-stats-value @ChangeClass(running.Change)">@SignedChange(running.Change)</div>
                <div class="player-stats-label">@L["RatingExpected"]</div>
            </div>
        }
    </div>

    @if (_rating.Timeline.Count > 1)
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@L["RatingHistory"]</MudText>
        @RatingChart
    }

    @if (_rating.Tournaments.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mt-4">@L["RatingNoGames"]</MudText>
    }
    else
    {
        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-2">@L["RatingTournaments"]</MudText>
        @* One card per tournament, newest first; tap the header to show the games. Narrow enough for a phone. *@
        <div class="rt-list">
            @foreach (var tournament in _rating.Tournaments)
            {
                var expanded = IsExpanded(tournament.TournamentId);
                <div @key="tournament.TournamentId" class="rt-card">
                    <button type="button" class="rt-head" aria-expanded="@(expanded ? "true" : "false")"
                            @onclick="() => Toggle(tournament.TournamentId)">
                        <div class="rt-head-main">
                            <div class="rt-title">
                                <span class="rt-title-text">@tournament.Title</span>
                                @if (!tournament.IsProcessed)
                                {
                                    <MudTooltip Text="@L["RatingProvisionalTournamentHelp"]">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="my-0 ml-0">@L["RatingProvisionalTournament"]</MudChip>
                                    </MudTooltip>
                                }
                            </div>
                            <div class="rt-sub">@SubLine(tournament)</div>
                        </div>
                        <span class="rt-badge @BadgeClass(tournament.Change)">@SignedChange(tournament.Change)</span>
                        <MudIcon Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                 Class="mud-text-secondary" />
                    </button>

                    @if (expanded)
                    {
                        <ul class="rt-games">
                            @foreach (var game in tournament.Games)
                            {
                                <li class="rt-game @(game.CountsForRating ? null : "rt-game-not-counted")">
                                    <span class="rt-round">@L["RatingGameRound", game.Round]</span>
                                    <span class="rt-color @(game.IsWhite ? "rt-color-white" : "rt-color-black")"
                                          title="@(game.IsWhite ? L["White"] : L["Black"])"></span>
                                    <div class="rt-game-main">
                                        <div class="rt-opponent">
                                            <PlayerName Name="@game.Opponent.Name" IsDeleted="game.Opponent.IsDeleted" />
                                            <span class="mud-text-secondary">(@game.OpponentRating)</span>
                                        </div>
                                        <div class="rt-detail">
                                            <span class="@Display.OutcomeClass(game.Result, game.IsWhite)">@L[$"Result_{game.Result}"]</span>
                                            @GameDetail(game)
                                        </div>
                                    </div>
                                    <span class="rt-change @ChangeClass(game.Change ?? 0)">
                                        @(game.CountsForRating && game.Change is { } c ? SignedExact(c) : "")
                                    </span>
                                </li>
                            }
                        </ul>
                        <div class="rt-total">
                            <span>@L["RatingTournamentTotal", Exact(tournament.ExactChange)]</span>
                            <b class="@ChangeClass(tournament.Change)">@SignedChange(tournament.Change)</b>
                        </div>
                    }
                </div>
            }
        </div>
    }
}

@code {

    // Chart geometry in SVG user units; the SVG scales to the width of the drawer.
    private const double Width = 640, Height = 220;
    private const double PlotLeft = 44, PlotRight = 12, PlotTop = 12, PlotBottom = 24;

    [Parameter, EditorRequired] public int PlayerId { get; set; }

    private PlayerRatingDto? _rating;
    private bool _failed;

    /// <summary>Tournaments opened or closed by the user; without a choice only the newest one is open.</summary>
    private readonly Dictionary<int, bool> _expanded = [];

    private bool IsExpanded(int tournamentId) =>
        _expanded.TryGetValue(tournamentId, out var expanded) ? expanded : _rating!.Tournaments[0].TournamentId == tournamentId;

    private void Toggle(int tournamentId) => _expanded[tournamentId] = !IsExpanded(tournamentId);

    private static string BadgeClass(int change) => change > 0 ? "rt-badge-up" : change < 0 ? "rt-badge-down" : "rt-badge-even";

    /// <summary>Date, number of games and the rating before and after, e.g. "3 nov 2026 · 5 partijen · 1450 → 1462".</summary>
    private string SubLine(RatingTournamentDto tournament)
    {
        var parts = new List<string>();
        if (tournament.Date is { } date) parts.Add(date.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture));
        parts.Add(L["RatingLogGames", tournament.Games.Count]);
        parts.Add($"{tournament.RatingBefore} → {tournament.RatingAfter}");
        return string.Join(" · ", parts);
    }

    /// <summary>After the result: the expected score and K, or why the game does not count.</summary>
    private string GameDetail(RatingGameDto game)
    {
        if (!game.CountsForRating) return $" · {L["RatingGameNotCounted"]}";
        var detail = "";
        if (game.ExpectedScore is { } expected) detail += $" · {L["RatingGameExpected", Num(expected)]}";
        if (game.K is { } k) detail += $" · K {k}";
        return detail;
    }

    /// <summary>Index of the point under the mouse (0 = rating before the first change), or null.</summary>
    private int? _hover;

    protected override async Task OnInitializedAsync()
    {
        try { _rating = await Api.GetPlayerRatingAsync(PlayerId); }
        catch (Exception) { _failed = true; }
    }

    private static string SignedChange(int change) => change > 0 ? $"+{change}" : change.ToString(CultureInfo.CurrentCulture);

    private static string? ChangeClass(int change) => change > 0 ? "outcome-win" : change < 0 ? "outcome-loss" : null;

    private static string? ChangeClass(decimal change) => change > 0 ? "outcome-win" : change < 0 ? "outcome-loss" : null;

    private static string Num(decimal value) => value.ToString("0.00", CultureInfo.CurrentCulture);

    private static string Exact(decimal value) => value.ToString("0.00", CultureInfo.CurrentCulture);

    private static string SignedExact(decimal change) => change > 0 ? $"+{Exact(change)}" : Exact(change);

    /// <summary>The rating before the first change, then the rating after every change.</summary>
    private List<int> Points() =>
        [_rating!.Timeline[0].RatingBefore, .. _rating.Timeline.Select(h => h.RatingAfter)];

    private RenderFragment RatingChart => __builder =>
    {
        var points = Points();
        var (min, max, step) = Scale(points.Min(), points.Max());
        var plotWidth = Width - PlotLeft - PlotRight;
        var plotHeight = Height - PlotTop - PlotBottom;
        double X(int i) => PlotLeft + (points.Count == 1 ? plotWidth / 2 : plotWidth * i / (points.Count - 1));
        double Y(int rating) => PlotTop + plotHeight * (max - rating) / (max - min);
        string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

        var line = string.Join(" ", points.Select((r, i) => $"{F(X(i))},{F(Y(r))}"));
        var showMarkers = points.Count <= 40;
        var bandWidth = points.Count == 1 ? plotWidth : plotWidth / (points.Count - 1);

        <div class="rating-chart" @onmouseleave="() => _hover = null">
            <svg viewBox="0 0 @F(Width) @F(Height)" role="img"
                 aria-label="@L["RatingChartLabel", points[0], points[^1]]">
                @for (var tick = min; tick <= max; tick += step)
                {
                    @* Wrapped in <g>: Razor treats a bare <text> in a code block as its own pseudo-tag. *@
                    <g>
                        <line class="rating-chart-grid" x1="@F(PlotLeft)" x2="@F(Width - PlotRight)" y1="@F(Y(tick))" y2="@F(Y(tick))" />
                        <text class="rating-chart-axis" x="@F(PlotLeft - 8)" y="@F(Y(tick))" text-anchor="end" dominant-baseline="middle">@tick</text>
                    </g>
                }

                @if (_hover is { } hover)
                {
                    <line class="rating-chart-crosshair" x1="@F(X(hover))" x2="@F(X(hover))" y1="@F(PlotTop)" y2="@F(Height - PlotBottom)" />
                }

                <polyline class="rating-chart-line" points="@line" />

                @for (var i = 0; i < points.Count; i++)
                {
                    var hovered = _hover == i;
                    if (showMarkers || hovered)
                    {
                        <circle class="rating-chart-marker" cx="@F(X(i))" cy="@F(Y(points[i]))" r="@(hovered ? "6" : "4")" />
                    }
                }

                @* Hit targets: a full-height band per point, much wider than the marker. *@
                @for (var i = 0; i < points.Count; i++)
                {
                    var index = i;
                    <rect class="rating-chart-hit" x="@F(X(i) - bandWidth / 2)" y="0" width="@F(bandWidth)" height="@F(Height)"
                          @onmouseenter="() => _hover = index" />
                }

                <text class="rating-chart-axis" x="@F(X(0))" y="@F(Height - 6)" text-anchor="start">@L["RatingStart"]</text>
                @if (points.Count > 1)
                {
                    <g>
                        <text class="rating-chart-axis" x="@F(X(points.Count - 1))" y="@F(Height - 6)" text-anchor="end">
                            @_rating!.Timeline[^1].At.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)
                        </text>
                    </g>
                }
            </svg>

            @if (_hover is { } shown)
            {
                var left = X(shown) / Width * 100;
                <div class="rating-chart-tooltip" style="left: @F(left)%; top: @F(Y(points[shown]) / Height * 100)%;
                         transform: translate(@(left > 60 ? "calc(-100% - 12px)" : "12px"), -50%)">
                    <div class="rating-chart-tooltip-value">@points[shown]</div>
                    @if (shown == 0)
                    {
                        <div>@L["RatingStart"]</div>
                    }
                    else
                    {
                        var change = _rating!.Timeline[shown - 1];
                        <div>
                            <span class="@ChangeClass(change.Change)">@SignedChange(change.Change)</span>
                            · @L[$"RatingReason_{change.Reason}"]
                        </div>
                        <div class="mud-text-secondary">
                            @(change.TournamentTitle is null ? "" : $"{change.TournamentTitle} · ")@change.At.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)
                        </div>
                    }
                </div>
            }
        </div>
    };

    /// <summary>Axis range rounded to a nice step (10, 20, 25, 50, 100 ...), with some room around the data.</summary>
    private static (int Min, int Max, int Step) Scale(int low, int high)
    {
        var span = Math.Max(high - low, 20);
        int[] steps = [5, 10, 20, 25, 50, 100, 200, 250, 500];
        var step = steps.FirstOrDefault(s => span / s <= 4, 1000);
        var min = (int)Math.Floor((low - step / 2.0) / step) * step;
        var max = (int)Math.Ceiling((high + step / 2.0) / step) * step;
        return (min, max, step);
    }
}
