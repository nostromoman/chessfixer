@inject IStringLocalizer<Strings> L

@* Confirmation before cancelling the round in progress: its pairing and any entered results are lost. *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
            <MudText Typo="Typo.h6">@L["CancelRoundTitle", RoundNumber]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">
            @L["CancelRoundWarning", RoundNumber]
        </MudAlert>
        @if (ResultCount > 0)
        {
            <MudText Typo="Typo.body1"><b>@L["CancelRoundResultsLost", ResultCount]</b></MudText>
        }
        else
        {
            <MudText Typo="Typo.body1">@L["CancelRoundRunningFor", MinutesRunning]</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@L["GoBack"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="() => Dialog.Close(true)">@L["CancelRoundConfirm"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public int RoundNumber { get; set; }

    /// <summary>Number of results already entered in the round.</summary>
    [Parameter] public int ResultCount { get; set; }

    [Parameter] public int MinutesRunning { get; set; }
}
