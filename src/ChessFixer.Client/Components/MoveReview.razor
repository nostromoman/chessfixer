@using ChessFixer.Core.Chess
@using Position = ChessFixer.Core.Chess.Position
@implements IAsyncDisposable
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS

@* The digital chess board on which the moves of a game are entered or checked, filling the screen: the photo of the
   scoresheet (when there is one) small on the left, the board in the middle and the moves on the right, White and Black
   next to each other per move number as on a scoresheet. Every move is replayed on the board: a move that is not
   possible is red. A move is typed (e4, Pf3 or Nf3) or played on the board by dragging or clicking the piece. Moves
   read by Claude are checked off against the photo (a move Claude was sure of is checked already); moves played on the
   board or pasted as PGN have nothing to check off. Used by the 'Analyse aanmaken' page and by the phone page of the
   QR code; the parent saves (OnChange) and decides when the moves are done (CanSave). *@
<div class="review-layout @(PhotoUrl is null ? "no-photo" : "")">
    @if (PhotoUrl is not null)
    {
        <div class="review-photo @(_zoomed ? "zoomed" : "")" title="@L["WizardZoom"]" @onclick="() => _zoomed = !_zoomed">
            <img src="@PhotoUrl" alt="@L["ScoresheetPhotos"]" />
        </div>
    }

    <div class="review-board">
        @BoardPanel
    </div>

    <div class="review-list">
        @if (!string.IsNullOrWhiteSpace(Remarks))
        {
            <MudAlert Severity="Severity.Info" Dense="true">@L["WizardRemarks"] <i>@Remarks</i></MudAlert>
        }
        @if (Help is not null)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary review-help">@Help</MudText>
        }
        <div class="review-moves" @ref="_list">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["WizardWhite"]</th>
                        <th>@L["WizardBlack"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _rows.Count; i += 2)
                    {
                        var white = i;
                        <tr>
                            <td class="review-move-number">@(white / 2 + 1).</td>
                            <td>@HalfMove(white)</td>
                            <td>
                                @if (white + 1 < _rows.Count)
                                {
                                    @HalfMove(white + 1)
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex flex-wrap gap-1">
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAtEnd">
                @L["WizardAddMove"]
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.PlaylistAdd"
                       OnClick="InsertBefore" Disabled="@(_rows.Count == 0)">@L["WizardInsertMove"]</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Delete" Color="Color.Error"
                       OnClick="DeleteSelected" Disabled="@(_rows.Count == 0)">@L["WizardDeleteMove"]</MudButton>
        </div>
    </div>
</div>

@code {
    /// <summary>The moves to start with (read from a photo, pasted as PGN, or none); only read when the component starts.</summary>
    [Parameter, EditorRequired] public ScoresheetReviewDto Review { get; set; } = null!;

    /// <summary>The photo of the scoresheet, shown next to the moves; null when there is none.</summary>
    [Parameter] public string? PhotoUrl { get; set; }

    /// <summary>Notes of Claude about the photo.</summary>
    [Parameter] public string? Remarks { get; set; }

    /// <summary>What the user does here, above the board.</summary>
    [Parameter] public string? Help { get; set; }

    /// <summary>Something changed: the parent saves <see cref="Current"/> (and re-renders its buttons).</summary>
    [Parameter] public EventCallback OnChange { get; set; }

    private sealed class Row
    {
        public string Text { get; set; } = "";
        public string ReadAs { get; init; } = "";
        public IReadOnlyList<string> Alternatives { get; init; } = [];
        public MoveConfidence Confidence { get; init; } = MoveConfidence.Low;
        public bool Checked { get; set; }
    }

    /// <summary>Empty: an empty move at the end (e.g. added after a move on the board); not saved.</summary>
    private enum MoveStatus { Legal, Illegal, Unknown, Empty }

    /// <summary>A move replayed on the board: legal or not, and the positions before and after it.</summary>
    private sealed record Check(MoveStatus Status, Position? Before, string? San = null, Move? Move = null, Position? After = null);

    private readonly List<Row> _rows = [];
    private List<Check> _checks = [];
    private int _selected;
    private bool _showAfter;
    private bool _zoomed;
    private int? _fromSquare;

    private static Row EmptyRow() => new() { Confidence = MoveConfidence.Low };

    protected override void OnInitialized()
    {
        _rows.AddRange(Review.Moves.Select(m => new Row
        {
            Text = m.Text, ReadAs = m.ReadAs, Alternatives = m.Alternatives, Confidence = m.Confidence, Checked = m.Checked
        }));
        // Room for the next move, to enter it on the board.
        if (_rows.Count == 0 || _rows[^1].Text.Length > 0) _rows.Add(EmptyRow());
        Validate();
        _selected = Math.Clamp(Review.Selected, 0, _rows.Count - 1);
        if (Review.Selected > 0) return; // continued where the user was

        // A fresh start: at the first move that is not possible, else at the first one to check (a read photo), else
        // after the last move (to go on entering moves).
        var toCheck = Manual ? -1 : _rows.FindIndex(r => !r.Checked && r.Text.Length > 0);
        _selected = FirstIllegal >= 0 ? FirstIllegal : toCheck >= 0 ? toCheck : Manual ? _rows.Count - 1 : 0;
    }

    // ----- What the parent needs -----

    /// <summary>The moves as they stand now, to save the work in progress.</summary>
    public ScoresheetReviewDto Current =>
        new(_rows.Select(r => new ScoresheetReviewMoveDto(r.Text, r.ReadAs, r.Alternatives, r.Confidence, r.Checked)).ToList(), _selected);

    /// <summary>The moves in standard notation; only meaningful when <see cref="CanSave"/>.</summary>
    public IReadOnlyList<string> Moves => _checks.Where(c => c.Status == MoveStatus.Legal).Select(c => c.San!).ToList();

    public int MoveCount => _checks.Count(c => c.Status != MoveStatus.Empty);

    public bool CanSave => MoveCount > 0 && FirstIllegal < 0 && UncheckedCount == 0;

    /// <summary>Why the moves cannot be saved yet, or how many there are.</summary>
    public string SaveHint
    {
        get
        {
            if (MoveCount == 0) return L["WizardNoMoves"];
            if (FirstIllegal is var i and >= 0) return L["WizardIllegalMove", MoveLabel(i)];
            if (Manual) return L["WizardMoveCount", MoveCount];
            return UncheckedCount > 0 ? L["WizardToCheck", UncheckedCount] : L["WizardAllChecked", MoveCount];
        }
    }

    /// <summary>
    /// No move was read by Claude (entered by hand, pasted, or the reading failed): there is nothing to check off
    /// against a reading, so no checkboxes and no confidence.
    /// </summary>
    public bool Manual => _rows.All(r => r.ReadAs.Length == 0);

    // ----- Replaying the moves -----

    /// <summary>
    /// Replays all moves from the start: legal up to the first move that is not, unknown after it. Empty moves at the
    /// end are left out (the first of them can be entered on the board).
    /// </summary>
    private void Validate()
    {
        var checks = new List<Check>(_rows.Count);
        Position? position = Position.FromFen(Position.StartFen);
        var lastFilled = _rows.FindLastIndex(r => !string.IsNullOrWhiteSpace(r.Text));
        for (var i = 0; i < _rows.Count; i++)
        {
            var row = _rows[i];
            if (i > lastFilled)
            {
                checks.Add(new Check(MoveStatus.Empty, i == lastFilled + 1 ? position : null));
                continue;
            }
            if (position is null)
            {
                checks.Add(new Check(MoveStatus.Unknown, null));
                continue;
            }
            try
            {
                if (string.IsNullOrWhiteSpace(row.Text)) throw new FormatException();
                var move = position.ParseSan(row.Text.Trim());
                var after = position.Play(move);
                checks.Add(new Check(MoveStatus.Legal, position, position.ToSan(move), move, after));
                position = after;
            }
            catch (Exception e) when (e is FormatException or ArgumentException or InvalidOperationException)
            {
                checks.Add(new Check(MoveStatus.Illegal, position));
                position = null;
            }
        }
        _checks = checks;
        _fromSquare = null;
    }

    private int FirstIllegal => _checks.FindIndex(c => c.Status is MoveStatus.Illegal or MoveStatus.Unknown);

    private int UncheckedCount =>
        Manual ? 0 : _rows.Where((r, i) => !r.Checked && _checks[i].Status != MoveStatus.Empty).Count();

    private static string MoveLabel(int index) => index % 2 == 0 ? $"{index / 2 + 1}." : $"{index / 2 + 1}...";

    // ----- The board -----

    private RenderFragment BoardPanel => __builder =>
    {
        if (_rows.Count == 0 || _selected >= _checks.Count)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["WizardNoMovesHelp"]</MudText>
            return;
        }
        var row = _rows[_selected];
        var check = _checks[_selected];
        var white = _selected % 2 == 0;
        <div>
        <MudText Typo="Typo.subtitle2" Class="mb-1">
            @MoveLabel(_selected) @(check.San ?? row.Text)
        </MudText>
        @if (check.Before is null && FirstIllegal < 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">@L["WizardFillEarlier"]</MudAlert>
        }
        else if (check.Before is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@L["WizardFixEarlier", MoveLabel(FirstIllegal)]</MudAlert>
        }
        else
        {
            var showAfter = _showAfter && check.After is not null;
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                @(showAfter ? L["WizardPositionAfter"]
                    : Manual ? L[white ? "WizardPositionWhite" : "WizardPositionBlack"]
                    : L[white ? "WizardPositionBeforeWhite" : "WizardPositionBeforeBlack"])
            </MudText>
            @if (showAfter)
            {
                <ChessBoard Fen="@check.After!.ToFen()" LastMove="@check.Move?.ToUci()" IsCheckMarked="@check.After.InCheck" />
            }
            else
            {
                <ChessBoard Fen="@check.Before.ToFen()" Arrow="@check.Move?.ToUci()" IsCheckMarked="@check.Before.InCheck"
                            OnSquareClick="SquareClicked" OnPieceDrop="PieceDropped" OnPieceDragStart="PieceDragStarted"
                            SelectedSquare="_fromSquare" Targets="Targets" />
            }
            <div class="d-flex align-center flex-wrap gap-1 mt-1">
                <MudTooltip Text="@L["WizardPrevious"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" aria-label="@L["WizardPrevious"]"
                                   OnClick="() => Select(_selected - 1)" Disabled="@(_selected == 0)" />
                </MudTooltip>
                @if (!Manual)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                               OnClick="ConfirmAndNext" Disabled="@(check.Status != MoveStatus.Legal)">@L["WizardConfirm"]</MudButton>
                }
                <MudTooltip Text="@L["WizardNext"]">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-label="@L["WizardNext"]"
                                   OnClick="() => Select(_selected + 1)" Disabled="@(_selected >= _rows.Count - 1)" />
                </MudTooltip>
                <MudSpacer />
                <MudSwitch T="bool" @bind-Value="_showAfter" Size="Size.Small" Color="Color.Primary"
                           Disabled="@(check.After is null)" Label="@L["WizardShowAfter"]" />
            </div>
            @if (!showAfter)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@L[Manual ? "WizardBoardHelpManual" : "WizardBoardHelp"]</MudText>
            }
        }
        @if (row.ReadAs.Length > 0)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@L["WizardReadAs"] <b>@row.ReadAs</b></MudText>
        }
        @if (row.Alternatives.Count > 0)
        {
            <div class="d-flex align-center flex-wrap gap-1 mt-1">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["WizardAlternatives"]</MudText>
                @foreach (var alternative in row.Alternatives)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" OnClick="() => UseText(_selected, alternative)">@alternative</MudChip>
                }
            </div>
        }
        </div>
    };

    /// <summary>One half-move in the table: (checkbox,) the move, and how sure Claude was (a colored dot).</summary>
    private RenderFragment HalfMove(int index) => __builder =>
    {
        var row = _rows[index];
        var check = _checks[index];
        var css = "review-half" + (index == _selected ? " selected" : "")
                  + (check.Status == MoveStatus.Illegal ? " illegal"
                      : check.Status == MoveStatus.Unknown ? " unknown"
                      : !row.Checked && !Manual && check.Status != MoveStatus.Empty ? " unchecked" : "");
        var title = check.Status switch
        {
            MoveStatus.Illegal => L["WizardIllegal"].Value,
            MoveStatus.Unknown => L["WizardUnknown"].Value,
            _ => null
        };
        var read = !Manual && check.Status != MoveStatus.Empty;
        <div class="@css" @onclick="() => Select(index)">
            @if (read)
            {
                <input type="checkbox" class="review-move-check" checked="@row.Checked"
                       aria-label="@L["WizardChecked"]" @onclick:stopPropagation="true"
                       @onchange="e => SetChecked(index, e.Value is true)" />
            }
            <input class="review-move-input" value="@row.Text" maxlength="20" spellcheck="false" autocomplete="off" autocapitalize="off"
                   aria-label="@($"{MoveLabel(index)} {L["WizardMove"]}")" title="@title"
                   @onfocus="() => Select(index)"
                   @oninput="e => TextChanged(index, e.Value?.ToString())"
                   @onblur="() => Normalize(index)"
                   @onkeydown="e => KeyDown(index, e)" />
            @if (read)
            {
                var (level, key) = row.ReadAs.Length == 0 ? ("added", "WizardAddedHelp") : row.Confidence switch
                {
                    MoveConfidence.High => ("high", "ConfidenceHighHelp"),
                    MoveConfidence.Medium => ("medium", "ConfidenceMediumHelp"),
                    _ => ("low", "ConfidenceLowHelp")
                };
                <span class="review-confidence-dot @level" title="@L[key]"></span>
            }
        </div>
    };

    /// <summary>The selected move stays in view in the list (and keeps the keyboard focus while typing).</summary>
    private ElementReference _list;
    private IJSObjectReference? _module;
    private int _shown = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The parent shows whether the moves can be saved: let it know right away (e.g. a pasted PGN that is fine).
        if (firstRender) await OnChange.InvokeAsync();
        if (_shown == _selected) return;
        _shown = _selected;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/MoveReview.razor.js");
            await _module.InvokeVoidAsync("showSelected", _list);
        }
        catch (JSException)
        {
            // Only a convenience.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone.
        }
    }

    // ----- Editing -----

    private void Changed() => _ = OnChange.InvokeAsync();

    private void Select(int index)
    {
        if (index < 0 || index >= _rows.Count || index == _selected) return;
        _selected = index;
        _fromSquare = null;
        Changed();
    }

    private void SetChecked(int index, bool value)
    {
        _rows[index].Checked = value;
        Changed();
    }

    /// <summary>Typed by the user: that is a checked move (the board says whether it is legal).</summary>
    private void TextChanged(int index, string? text)
    {
        _rows[index].Text = (text ?? "").Trim();
        _rows[index].Checked = true;
        Validate();
        Changed();
    }

    /// <summary>A legal move is written in standard notation (e.g. Pf3 becomes Nf3) when the user leaves the field.</summary>
    private void Normalize(int index)
    {
        if (index < _checks.Count && _checks[index] is { Status: MoveStatus.Legal, San: { } san } && _rows[index].Text != san)
        {
            _rows[index].Text = san;
            Changed();
        }
    }

    private void UseText(int index, string text)
    {
        _rows[index].Text = text;
        _rows[index].Checked = true;
        Validate();
        Normalize(index);
        Changed();
    }

    /// <summary>Enter: the move is right, go to the next one; arrow keys move between the moves.</summary>
    private void KeyDown(int index, KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                Normalize(index);
                if (_checks[index].Status == MoveStatus.Legal) ConfirmAndNext();
                break;
            case "ArrowDown":
                Select(index + 1);
                break;
            case "ArrowUp":
                Select(index - 1);
                break;
        }
    }

    /// <summary>The selected move is right: check it and go to the next move that still has to be checked.</summary>
    private void ConfirmAndNext()
    {
        if (_rows.Count == 0) return;
        _rows[_selected].Checked = true;
        var next = Manual ? -1 : _rows.FindIndex(_selected + 1, r => !r.Checked);
        if (next < 0 && !Manual) next = _rows.FindIndex(r => !r.Checked);
        if (next < 0) next = Math.Min(_selected + 1, _rows.Count - 1);
        _selected = next;
        _fromSquare = null;
        Changed();
    }

    private void AddAtEnd()
    {
        _rows.Add(EmptyRow());
        _selected = _rows.Count - 1;
        Validate();
        Changed();
    }

    /// <summary>A move that was missed: an empty move before the selected one (the colors after it shift).</summary>
    private void InsertBefore()
    {
        _rows.Insert(_selected, EmptyRow());
        Validate();
        Changed();
    }

    /// <summary>A move that was read twice or does not belong there (the colors after it shift).</summary>
    private void DeleteSelected()
    {
        if (_rows.Count == 0) return;
        _rows.RemoveAt(_selected);
        if (_rows.Count == 0) _rows.Add(EmptyRow());
        _selected = Math.Clamp(_selected, 0, Math.Max(0, _rows.Count - 1));
        Validate();
        Changed();
    }

    // ----- A move on the board: drag the piece, or click the piece and then the square it goes to -----

    private IReadOnlyCollection<int>? Targets =>
        _fromSquare is { } from && _checks[_selected].Before is { } position
            ? position.LegalMoves().Where(m => m.From == from).Select(m => m.To).ToHashSet()
            : null;

    private void SquareClicked(int square)
    {
        if (_checks[_selected].Before is not { } position) return;
        if (_fromSquare is { } from && TryPlay(position, from, square)) return;
        _fromSquare = position.LegalMoves().Any(m => m.From == square) && square != _fromSquare ? square : null;
    }

    private void PieceDragStarted(int square)
    {
        if (_checks[_selected].Before is { } position && position.LegalMoves().Any(m => m.From == square)) _fromSquare = square;
    }

    private void PieceDropped(ChessBoard.PieceDrop drop)
    {
        if (_checks[_selected].Before is { } position && TryPlay(position, drop.From, drop.To)) return;
        _fromSquare = null; // not a legal move: the piece goes back
    }

    /// <summary>Plays the move on the board as the selected move, when it is legal.</summary>
    private bool TryPlay(Position position, int from, int to)
    {
        var moves = position.LegalMoves().Where(m => m.From == from && m.To == to).ToList();
        if (moves.Count == 0) return false;
        // A promotion becomes a queen; another piece can be typed (e.g. e8=N).
        var move = moves.FirstOrDefault(m => m.Promotion is '\0' or 'Q');
        if (move == default) move = moves[0];
        _rows[_selected].Text = position.ToSan(move);
        _rows[_selected].Checked = true;
        if (_selected == _rows.Count - 1)
        {
            // The last move: a new one right after it, to play the next move on the board.
            _rows.Add(EmptyRow());
        }
        // On to the next move, so a whole game can be played on the board.
        if (Manual || _rows[_selected + 1].Text.Length == 0) _selected++;
        Validate();
        Changed();
        return true;
    }
}
