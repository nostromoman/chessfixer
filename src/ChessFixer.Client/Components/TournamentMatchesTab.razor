@inject IStringLocalizer<Strings> L

@* The games per round, with a row of tabs: one tab per started round, the newest on the right. Starting a round
   adds its tab and opens it. Results can only be entered (and corrected) in the most recent round; the other
   rounds show their results. Before round 1 the pairing of round 1 is shown (without tabs).
   A player with a bye is shown in a separate group at the bottom, then the players without opponent (competition)
   and the absent players, then the catch-up games entered during the round (competition), then the round report.
   A finished round has a green check mark on its tab; the round in progress an hourglass. *@
@if (StartedRounds.Count > 0)
{
    <MudTabs @ref="_roundTabs" ActivePanelIndex="_selectedIndex" ActivePanelIndexChanged="i => _selectedIndex = i"
             Elevation="0" Outlined="true" Rounded="true" MinimumTabWidth="110px" Class="round-tabs" TabPanelsClass="pt-4">
        @foreach (var round in StartedRounds)
        {
            var inProgress = round == CurrentRound && Tournament.State == TournamentState.RoundActive;
            <MudTabPanel @key="round.Number" Text="@L["Round", round.Number]"
                         Icon="@(inProgress ? Icons.Material.Filled.HourglassTop : round.IsFinished ? Icons.Material.Filled.CheckCircle : null)"
                         IconColor="@(inProgress ? Color.Warning : round.IsFinished ? Color.Success : Color.Default)">
                @if (round == CurrentRound && Tournament.State is TournamentState.RoundActive or TournamentState.WaitingForNextRound)
                {
                    @CurrentRoundContent(round)
                }
                else
                {
                    @PlayedRoundContent(round)
                }
            </MudTabPanel>
        }
    </MudTabs>
}
else if (Tournament.State == TournamentState.New && PendingRound is not null)
{
    <MudText Typo="Typo.h5" Class="mb-3"><b>@L["PairingRound", PendingRound.Number]</b></MudText>
    @if (PendingRound.Games.Count(g => g.TimesMetBefore >= 2) is var repeats and > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">@L["RepeatMeetingsInPairing", repeats]</MudAlert>
    }
    @Cards(Games(PendingRound).Where(g => g.Board is not null).OrderBy(g => g.Board), isStarted: false, editable: false)

    @if (Queue(PendingRound).Any())
    {
        <MudText Typo="Typo.h6" Class="mt-6">@L["GamesQueue"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["GamesQueueInfo"]</MudText>
        @Cards(Queue(PendingRound), isStarted: false, editable: false, queued: true)
    }

    @Byes(PendingRound, isStarted: false)
}
else if (Tournament.State == TournamentState.New)
{
    <MudAlert Severity="Severity.Info">@L["NoPairingYet"]</MudAlert>
}

@code {
    [Parameter, EditorRequired] public TournamentDto Tournament { get; set; } = null!;
    [Parameter, EditorRequired] public List<RoundDto> Rounds { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyDictionary<int, PlayerDto> Players { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<(GameDto Game, GameResult Result)> OnResult { get; set; }

    /// <summary>The leader finished the report wizard for a round.</summary>
    [Parameter] public EventCallback<(int Round, GenerateReportRequest Request)> OnGenerateReport { get; set; }

    /// <summary>The started rounds, oldest first: one tab each.</summary>
    private List<RoundDto> StartedRounds { get; set; } = [];

    /// <summary>The most recent started round (active, or just finished).</summary>
    private RoundDto? CurrentRound => StartedRounds.LastOrDefault();

    private MudTabs? _roundTabs;

    /// <summary>The index of the open round tab.</summary>
    private int _selectedIndex;

    /// <summary>Set when the newest round tab must be opened after the next render (a tab was added or removed).</summary>
    private bool _activateSelected;

    private int? _previousStartedCount;

    /// <summary>The next round, already paired but not started.</summary>
    private RoundDto? PendingRound => Rounds.FirstOrDefault(r => !r.IsStarted);

    /// <summary>The real games of a round, without byes and catch-up games.</summary>
    private static IEnumerable<GameDto> Games(RoundDto round) => round.Games.Where(g => g.Black is not null && !g.IsCatchUp);

    /// <summary>Competition: games played outside the club evening, entered while this was the latest round.</summary>
    private static List<GameDto> CatchUps(RoundDto round) =>
        round.Games.Where(g => g.IsCatchUp).OrderBy(g => g.PlayedAt).ThenBy(g => g.Number).ToList();

    private static IEnumerable<GameDto> Playing(RoundDto round) =>
        Games(round).Where(g => g.Board is not null && g.Result == GameResult.NotPlayed).OrderBy(g => g.Board);

    /// <summary>Games waiting for a free board, in the order they will get one.</summary>
    private static IEnumerable<GameDto> Queue(RoundDto round) =>
        Games(round).Where(g => g.Board is null && g.Result == GameResult.NotPlayed).OrderBy(g => g.Number);

    private static IEnumerable<GameDto> Finished(RoundDto round) =>
        Games(round).Where(g => g.Result != GameResult.NotPlayed).OrderBy(g => g.Number);


    /// <summary>How long the leave animation takes before the result is sent (see .game-card-leaving).</summary>
    private const int LeaveAnimationMs = 350;

    private enum Group { Playing, Queue, Finished }

    /// <summary>Cards playing the leave animation: their result was just entered.</summary>
    private readonly HashSet<int> _leaving = [];

    /// <summary>Cards that moved to another group since the previous render: they play the enter animation.</summary>
    private HashSet<int> _entering = [];

    /// <summary>The group of each game of the current round at the previous render; null before the first data.</summary>
    private Dictionary<int, Group>? _previousGroups;
    private List<RoundDto>? _previousRounds;

    /// <summary>Finds the games that changed group (also by changes from other screens), to animate them.</summary>
    protected override void OnParametersSet()
    {
        // Only on new data: other renders (e.g. busy on/off) must not cut off a running animation.
        if (ReferenceEquals(Rounds, _previousRounds)) return;
        _previousRounds = Rounds;
        StartedRounds = Rounds.Where(r => r.IsStarted).OrderBy(r => r.Number).ToList();

        // A round was started (or cancelled), or this is the first data: open the newest round.
        if (StartedRounds.Count != _previousStartedCount)
        {
            _selectedIndex = Math.Max(0, StartedRounds.Count - 1);
            _activateSelected = true;
        }
        _previousStartedCount = StartedRounds.Count;

        var groups = CurrentRound is null
            ? new Dictionary<int, Group>()
            : Games(CurrentRound).ToDictionary(g => g.Id, GroupOf);

        _entering = _previousGroups is null
            ? []
            : groups.Where(g => _previousGroups.TryGetValue(g.Key, out var before) && before != g.Value)
                    .Select(g => g.Key).ToHashSet();
        _previousGroups = groups;
        _leaving.RemoveWhere(id => !groups.TryGetValue(id, out var group) || group != Group.Playing);
    }

    /// <summary>A new tab only exists after the render; open it then.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_activateSelected || _roundTabs is null) return;
        _activateSelected = false;
        await _roundTabs.ActivatePanelAsync(_selectedIndex);
    }

    /// <summary>The most recent round, while results can be entered: playing, queue and finished games.</summary>
    private RenderFragment CurrentRoundContent(RoundDto round) => __builder =>
    {
        <div class="d-flex justify-end align-center mb-3">
            <MudText Typo="Typo.body1" Class="mud-text-secondary">
                @L["ResultsEntered", Finished(round).Count(), Games(round).Count()]
            </MudText>
        </div>

        @if (Playing(round).Any())
        {
            <MudText Typo="Typo.h6" Class="mb-3">@L["GamesPlaying"]</MudText>
            @Cards(Playing(round), isStarted: true, editable: true)
        }

        @if (Queue(round).Any())
        {
            <MudText Typo="Typo.h6" Class="mt-6">@L["GamesQueue"]</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["GamesQueueInfo"]</MudText>
            @Cards(Queue(round), isStarted: true, editable: false, queued: true)
        }

        @if (Finished(round).Any())
        {
            <MudText Typo="Typo.h6" Class="mt-6 mb-3">@L["GamesFinished"]</MudText>
            @Cards(Finished(round), isStarted: true, editable: true)
        }

        @Byes(round, isStarted: true)
        @CatchUpGames(round)
        @Report(round)
    };

    /// <summary>An earlier round (or any round of a closed tournament): its results, read-only.</summary>
    private RenderFragment PlayedRoundContent(RoundDto round) => __builder =>
    {
        <MudText Typo="Typo.h6" Class="mb-3">@L["ResultsRound", round.Number]</MudText>
        @Cards(Finished(round), isStarted: true, editable: false)
        @Byes(round, isStarted: true)
        @CatchUpGames(round)
        @Report(round)
    };

    /// <summary>The AI report of a round, at the bottom of the round; it can be made once every result is in.</summary>
    private RenderFragment Report(RoundDto round) => __builder =>
    {
        <MudDivider Class="mt-6 mb-4" />
        <MudText Typo="Typo.h6" Class="mb-2">@L["RoundReportTitle", round.Number]</MudText>
        <TournamentReportTab TournamentId="Tournament.Id" RoundNumber="round.Number"
                             Report="@(round.Report ?? new TournamentReportDto(ReportStatus.None, null, null, null, null, false))"
                             NotAvailableReason="@(round.IsFinished ? null : L["RoundReportNotYet"].Value)"
                             Disabled="Disabled" OnGenerate="request => OnGenerateReport.InvokeAsync((round.Number, request))" />
    };

    private static Group GroupOf(GameDto game) =>
        game.Result != GameResult.NotPlayed ? Group.Finished
        : game.Board is null ? Group.Queue
        : Group.Playing;

    /// <summary>A result for a game in progress first lets the card fade out, then sends the result.</summary>
    private async Task SetResultAsync(GameDto game, GameResult result)
    {
        if (_leaving.Contains(game.Id)) return; // a second click during the animation
        if (GroupOf(game) == Group.Playing && result != GameResult.NotPlayed)
        {
            _leaving.Add(game.Id);
            StateHasChanged();
            await Task.Delay(LeaveAnimationMs);
        }

        await OnResult.InvokeAsync((game, result));
        _leaving.Remove(game.Id);
    }

    /// <summary>
    /// The player(s) with a bye in a round, in their own group, and then the absent players (by name only);
    /// nothing when there are none.
    /// </summary>
    private RenderFragment Byes(RoundDto round, bool isStarted) => __builder =>
    {
        var byes = round.Games.Where(g => g.Result == GameResult.Bye).OrderBy(g => g.Number).ToList();
        if (byes.Count > 0)
        {
            <MudText Typo="Typo.h6" Class="mt-6 mb-3">@L["GamesBye"]</MudText>
            @Cards(byes, isStarted, editable: false)
        }

        @PlayerChips(round, GameResult.NoOpponent, L["GamesNoOpponent"], Icons.Material.Filled.PersonOff, L["GamesNoOpponentInfo"])
        @PlayerChips(round, GameResult.Absent, L["GamesAbsent"], Icons.Material.Filled.EventBusy)
    };

    /// <summary>The players with a line of the given kind (absent, no opponent), by name only; nothing when there are none.</summary>
    private static RenderFragment PlayerChips(RoundDto round, GameResult result, string title, string icon, string? info = null) => __builder =>
    {
        var lines = round.Games.Where(g => g.Result == result).OrderBy(g => g.Number).ToList();
        if (lines.Count == 0) return;

        <MudText Typo="Typo.h6" Class="@(info is null ? "mt-6 mb-2" : "mt-6")">@title</MudText>
        @if (info is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@info</MudText>
        }
        <div class="d-flex flex-wrap gap-1">
            @foreach (var game in lines)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@icon" Class="ma-0">
                    <PlayerName Name="@game.White.Name" IsDeleted="game.White.IsDeleted" />
                </MudChip>
            }
        </div>
    };

    /// <summary>Competition: the catch-up games entered while this was the latest round. Their result can be corrected
    /// (clearing it removes the game) until the competition is closed.</summary>
    private RenderFragment CatchUpGames(RoundDto round) => __builder =>
    {
        var games = CatchUps(round);
        if (games.Count == 0) return;

        <MudText Typo="Typo.h6" Class="mt-6">@L["CatchUpGames"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["CatchUpGamesInfo"]</MudText>
        @Cards(games, isStarted: true, editable: Tournament.State != TournamentState.Closed)
    };

    private RenderFragment Cards(IEnumerable<GameDto> games, bool isStarted, bool editable, bool queued = false) =>
        @<div class="game-cards">
            @foreach (var (game, index) in games.Select((g, i) => (g, i)))
            {
                <GameCard @key="game.Id" Game="game" IsStarted="isStarted" Editable="editable" Disabled="Disabled"
                          QueuePosition="@(queued ? index + 1 : null)" Players="Players"
                          Leaving="_leaving.Contains(game.Id)" Entering="_entering.Contains(game.Id)"
                          OnResult="result => SetResultAsync(game, result)" />
            }
        </div>;
}
