@inject IStringLocalizer<Strings> L

@* Shows the result of a game and, when editable, lets the user enter or change it. *@
@if (Game.Black is null)
{
    @* Bye: the black column already says "vrij". *@
}
else if (!Editable)
{
    <MudText Typo="Typo.body1"><b>@L[$"Result_{Game.Result}"]</b></MudText>
}
else if (Game.Result == GameResult.NotPlayed)
{
    <div class="d-flex align-center justify-center">
        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
            <MudButton Disabled="Disabled" OnClick="() => OnResult.InvokeAsync(GameResult.WhiteWins)">@L["Result_WhiteWins"]</MudButton>
            <MudButton Disabled="Disabled" OnClick="() => OnResult.InvokeAsync(GameResult.Draw)">@L["Result_Draw"]</MudButton>
            <MudButton Disabled="Disabled" OnClick="() => OnResult.InvokeAsync(GameResult.BlackWins)">@L["Result_BlackWins"]</MudButton>
        </MudButtonGroup>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Disabled="Disabled" AriaLabel="@L["Forfeit"]">
            <MudMenuItem OnClick="() => OnResult.InvokeAsync(GameResult.WhiteWinsByForfeit)">@L["Result_WhiteWinsByForfeit"]</MudMenuItem>
            <MudMenuItem OnClick="() => OnResult.InvokeAsync(GameResult.BlackWinsByForfeit)">@L["Result_BlackWinsByForfeit"]</MudMenuItem>
        </MudMenu>
    </div>
}
else
{
    <div class="d-flex align-center justify-center">
        <MudText Typo="Typo.body1"><b>@L[$"Result_{Game.Result}"]</b></MudText>
        <MudMenu Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="Disabled" AriaLabel="@L["ChangeResult"]">
            @foreach (var result in ChangeableResults)
            {
                <MudMenuItem OnClick="() => OnResult.InvokeAsync(result)">@L[$"Result_{result}"]</MudMenuItem>
            }
            <MudDivider />
            <MudMenuItem OnClick="() => OnResult.InvokeAsync(GameResult.NotPlayed)">@L["ClearResult"]</MudMenuItem>
        </MudMenu>
    </div>
}

@code {
    private static readonly GameResult[] AllResults =
    [
        GameResult.WhiteWins, GameResult.Draw, GameResult.BlackWins,
        GameResult.WhiteWinsByForfeit, GameResult.BlackWinsByForfeit
    ];

    [Parameter, EditorRequired] public GameDto Game { get; set; } = null!;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<GameResult> OnResult { get; set; }

    private IEnumerable<GameResult> ChangeableResults => AllResults.Where(r => r != Game.Result);
}
