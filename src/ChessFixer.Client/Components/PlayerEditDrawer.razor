@inject TournamentApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject DeviceInfo Device
@inject IStringLocalizer<Strings> L

@* Drawer from the right to create or edit a player of the central list. Open it with OpenNew or OpenEdit.
   The header shows the player's name. Clicking next to the drawer, Escape or the close button closes it; with unsaved
   changes it first asks whether to save them, throw them away or keep editing. The overlay is our own (not the
   drawer's), because the drawer's overlay closes it without asking. *@
<MudOverlay Visible="_open" DarkBackground="true" Class="mud-overlay-drawer" OnClick="RequestCloseAsync" />
<MudDrawer @bind-Open="_open" Anchor="Anchor.End" Variant="DrawerVariant.Temporary" Overlay="false"
           Elevation="2" Width="50vw" Class="side-drawer">
    @if (_editing is not null)
    {
        <MudDrawerHeader Class="d-flex align-center gap-3">
            @if (_editing.IsNew)
            {
                <MudText Typo="Typo.h6">@L["NewPlayer"]</MudText>
            }
            else
            {
                <PlayerAvatar FirstName="@_editing.OriginalFirstName" LastName="@_editing.OriginalLastName"
                              PhotoUrl="@_editing.OriginalPhotoUrl" Size="Size.Medium" />
                <div class="drawer-title">
                    <MudText Typo="Typo.h6" Class="drawer-title-name">@_editing.OriginalName</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["EditPlayer"]</MudText>
                </div>
            }
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L["Close"]" OnClick="RequestCloseAsync" />
        </MudDrawerHeader>

        @if (_editing.IsNew)
        {
            <div class="px-6 pb-6">@GeneralForm</div>
        }
        else
        {
            @if (_editing.IsDeleted)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mx-6 mb-2">@L["PlayerDeletedInfo"]</MudAlert>
            }
            @* Keyed on the player, so the statistics reload and the first tab is shown for every player opened. *@
            <MudTabs @key="_editing.Id" @bind-ActivePanelIndex="_tab" Elevation="0" ApplyEffectsToContainer="true"
                     TabPanelsClass="px-6 pt-4 pb-6">
                <MudTabPanel Text="@L["PlayerTabGeneral"]" Icon="@Icons.Material.Outlined.Person">
                    @GeneralForm
                </MudTabPanel>
                <MudTabPanel Text="@L["PlayerTabStatistics"]" Icon="@Icons.Material.Outlined.BarChart">
                    <PlayerStatisticsTab PlayerId="_editing.Id!.Value" />
                </MudTabPanel>
                <MudTabPanel Text="@L["PlayerTabRating"]" Icon="@Icons.Material.Outlined.ShowChart">
                    <PlayerRatingTab PlayerId="_editing.Id!.Value" />
                </MudTabPanel>
                <MudTabPanel Text="@L["PlayerTabGames"]" Icon="@Icons.Material.Outlined.QueryStats">
                    <PlayerGamesTab PlayerId="_editing.Id!.Value" />
                </MudTabPanel>
            </MudTabs>
        }
    }
</MudDrawer>

@code {
    /// <summary>Photos are resized in the browser to at most this size (in pixels) before uploading.</summary>
    private const int PhotoSize = 400;
    private const string PhotoContentType = "image/jpeg";

    /// <summary>Starting rating of a new player (same as the server default).</summary>
    private const int DefaultRating = 1400;

    /// <summary>Called after a player has been created or updated.</summary>
    [Parameter] public EventCallback<PlayerDto> OnSaved { get; set; }

    private bool _open;
    private EditModel? _editing;
    private List<ClubDto> _clubs = [];

    private static string ClubLabel(ClubDto club) => club.City is null ? club.Name : $"{club.Name} ({club.City})";
    private MudFileUpload<IBrowserFile>? _photoUpload;
    private bool _busy;

    /// <summary>The player data form: on its own for a new player, in the "Algemeen" tab for an existing one.</summary>
    private RenderFragment GeneralForm => __builder =>
    {
        if (_editing is null) return;
        <div class="d-flex flex-column gap-4">
            @* The photo, with a pencil that opens a menu to choose, take or remove a photo. *@
            <div class="photo-edit">
                <PlayerAvatar FirstName="@_editing.FirstName" LastName="@_editing.LastName" PhotoUrl="@_editing.PhotoSource"
                              Size="Size.Large" />
                <MudMenu Class="photo-edit-menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                         aria-label="@L["EditPhoto"]">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Variant="Variant.Filled"
                                       Color="Color.Primary" Class="photo-edit-button" Disabled="_busy"
                                       aria-label="@L["EditPhoto"]" OnClick="e => context.ToggleAsync(e)" />
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.PhotoLibrary" OnClick="ChoosePhotoAsync">@L["ChoosePhoto"]</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Videocam" OnClick="TakePhotoAsync">@L["WebcamTakePhoto"]</MudMenuItem>
                        @if (_editing.PhotoSource is not null)
                        {
                            <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="RemovePhoto">@L["RemovePhoto"]</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
                @* No visible content: the file picker is opened from the menu. *@
                <MudFileUpload @ref="_photoUpload" T="IBrowserFile" Accept="image/*" FilesChanged="OnPhotoSelectedAsync"
                               Disabled="_busy" Class="d-none">
                    <CustomContent Context="upload" />
                    <SelectedTemplate />
                </MudFileUpload>
            </div>

            <MudTextField @bind-Value="_editing.FirstName" Label="@L["FirstName"]" Variant="Variant.Outlined"
                          Required="true" RequiredError="@L["FirstNameRequired"]" Immediate="true"
                          AutoFocus="Device.AutoFocus" MaxLength="50" OnKeyUp="OnKeyUp" Disabled="_busy" />
            <MudTextField @bind-Value="_editing.LastName" Label="@L["LastName"]" Variant="Variant.Outlined"
                          Immediate="true" MaxLength="50" OnKeyUp="OnKeyUp" Disabled="_busy" />
            <MudDatePicker @bind-Date="_editing.BirthDate" Label="@L["BirthDate"]" Variant="Variant.Outlined"
                           Editable="true" Clearable="true" DateFormat="dd-MM-yyyy" Placeholder="dd-mm-jjjj"
                           OpenTo="OpenTo.Year" MaxDate="DateTime.Today" PickerVariant="PickerVariant.Dialog"
                           Disabled="_busy" />
            <MudTextField @bind-Value="_editing.City" Label="@L["City"]" Variant="Variant.Outlined"
                          MaxLength="100" OnKeyUp="OnKeyUp" Disabled="_busy" />
            <MudNumericField T="int" @bind-Value="_editing.Rating" Label="@L["Rating"]" Variant="Variant.Outlined"
                             HelperText="@(_editing.IsNew ? L["RatingHelpNew"] : L["RatingHelp"])" Max="4000"
                             Min="0" HideSpinButtons="true" OnKeyUp="OnKeyUp" Disabled="_busy" />
            <div>
                <MudSwitch T="bool" @bind-Value="_editing.IsGuest" Color="Color.Primary" Label="@L["GuestPlayer"]" Disabled="_busy" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@L["GuestPlayerHelp"]</MudText>
            </div>
            @if (_editing.IsGuest)
            {
                <MudSelect T="int?" @bind-Value="_editing.ClubId" Label="@L["Club"]" Variant="Variant.Outlined" Disabled="_busy"
                           HelperText="@(_clubs.Count == 0 ? L["GuestClubNoClubs"] : L["GuestClubHelp"])"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int?" Value="null">@L["NoClub"]</MudSelectItem>
                    @foreach (var club in _clubs.Where(c => !c.IsOwnClub || c.Id == _editing.ClubId))
                    {
                        <MudSelectItem T="int?" Value="club.Id">@ClubLabel(club)</MudSelectItem>
                    }
                </MudSelect>
            }

            <div class="d-flex gap-2 justify-end">
                <MudButton Variant="Variant.Text" OnClick="Close" Disabled="_busy">@L["Cancel"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                           Disabled="@(!CanSave)" OnClick="SaveAsync">@L["Save"]</MudButton>
            </div>
        </div>
    };

    private bool CanSave => _editing is not null && !string.IsNullOrWhiteSpace(_editing.FirstName) && !_busy;

    public void OpenNew()
    {
        _editing = new EditModel(null, null);
        _editing.MarkClean();
        _open = true;
        StateHasChanged();
        _ = LoadClubsAsync();
    }

    /// <summary>The clubs for the club dropdown of a guest player; reloaded on every open (clubs may have changed).</summary>
    private async Task LoadClubsAsync()
    {
        try
        {
            _clubs = await Api.GetClubsAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            // Without clubs the dropdown only offers "geen club".
        }
    }

    /// <summary>Index of the rating tab, for <see cref="OpenEdit"/>.</summary>
    public const int RatingTab = 2;

    private int _tab;

    /// <param name="tab">The tab to show; the first (general) tab by default.</param>
    public void OpenEdit(PlayerDto player, int tab = 0)
    {
        _tab = tab;
        _editing = new EditModel(player.Id, player.PhotoUrl)
        {
            OriginalName = player.Name,
            OriginalFirstName = player.FirstName,
            OriginalLastName = player.LastName,
            IsDeleted = player.IsDeleted,
            FirstName = player.FirstName,
            LastName = player.LastName,
            BirthDate = player.BirthDate?.ToDateTime(TimeOnly.MinValue),
            City = player.City,
            IsGuest = player.IsGuest,
            ClubId = player.ClubId,
            Rating = player.Rating
        };
        _editing.MarkClean();
        _open = true;
        StateHasChanged();
        _ = LoadClubsAsync();
    }

    private void Close() => _open = false;

    /// <summary>
    /// Close from outside the form (overlay, Escape, close button): with unsaved changes, first ask whether to save
    /// them, throw them away or keep editing.
    /// </summary>
    private async Task RequestCloseAsync()
    {
        if (_editing is null || !_editing.IsDirty)
        {
            Close();
            return;
        }

        var choice = await Dialogs.ShowMessageBoxAsync(
            L["UnsavedChangesTitle"], L["UnsavedPlayerChangesText"],
            yesText: L["Save"], noText: L["DiscardChanges"], cancelText: L["KeepEditing"]);
        if (choice == true) await SaveAsync();
        else if (choice == false) Close();
    }

    private async Task OnPhotoSelectedAsync(IBrowserFile? file)
    {
        if (file is null || _editing is null) return;
        try
        {
            var resized = await file.RequestImageFileAsync(PhotoContentType, PhotoSize, PhotoSize);
            using var buffer = new MemoryStream();
            await resized.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).CopyToAsync(buffer);
            _editing.SetNewPhoto(buffer.ToArray(), PhotoContentType);
        }
        catch (Exception)
        {
            Snackbar.Add(L["PhotoUnreadable"], Severity.Error);
        }

        // Clear the selection so choosing the same file again triggers a new change.
        if (_photoUpload is not null) await _photoUpload.ClearAsync();
    }

    /// <summary>Takes a photo with the webcam in a dialog; it becomes the new photo when the user keeps it.</summary>
    private async Task TakePhotoAsync()
    {
        var dialog = await Dialogs.ShowAsync<WebcamDialog>(L["WebcamTakePhoto"],
            new DialogParameters<WebcamDialog> { { d => d.Size, PhotoSize } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: byte[] photo } && _editing is not null)
        {
            _editing.SetNewPhoto(photo, PhotoContentType);
            StateHasChanged();
        }
    }

    private async Task ChoosePhotoAsync()
    {
        if (_photoUpload is not null) await _photoUpload.OpenFilePickerAsync();
    }

    private void RemovePhoto() => _editing?.RemovePhoto();

    private async Task SaveAsync()
    {
        if (!CanSave) return;
        var editing = _editing!;

        _busy = true;
        PlayerDto? saved = null;
        try
        {
            var birthDate = editing.BirthDate is { } date ? DateOnly.FromDateTime(date) : (DateOnly?)null;
            PlayerDto player;
            if (editing.Id is { } id)
            {
                player = await Api.UpdatePlayerAsync(id, new UpdatePlayerRequest(
                    editing.FirstName, editing.LastName, editing.Rating, birthDate, editing.City,
                    editing.IsGuest, editing.IsGuest ? editing.ClubId : null));
            }
            else
            {
                player = await Api.CreatePlayerAsync(new CreatePlayerRequest(
                    editing.FirstName, editing.LastName, editing.Rating, birthDate, editing.City,
                    editing.IsGuest, editing.IsGuest ? editing.ClubId : null));
            }

            if (editing.NewPhoto is { } photo)
                await Api.SetPlayerPhotoAsync(player.Id, photo, PhotoContentType);
            else if (editing.PhotoRemoved && player.PhotoVersion is not null)
                await Api.DeletePlayerPhotoAsync(player.Id);

            Snackbar.Add(editing.IsNew ? L["PlayerCreated", player.Name] : L["PlayerUpdated", player.Name], Severity.Success);
            _open = false;
            saved = player;
        }
        catch (ApiClientException e)
        {
            Snackbar.Add(e.Code is { } code ? L[$"Error_{code}"] : L["Error_Unknown"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["Error_ServerUnavailable"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        if (saved is not null) await OnSaved.InvokeAsync(saved);
    }

    private async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveAsync();
        else if (e.Key == "Escape") await RequestCloseAsync();
    }

    private sealed class EditModel(int? id, string? photoUrl)
    {
        public int? Id { get; } = id;
        public bool IsNew => Id is null;
        public bool IsDeleted { get; init; }

        /// <summary>The name and photo as saved, for the header (they do not change while typing).</summary>
        public string OriginalName { get; init; } = "";
        public string OriginalFirstName { get; init; } = "";
        public string OriginalLastName { get; init; } = "";
        public string? OriginalPhotoUrl { get; } = photoUrl;

        private object? _clean;

        /// <summary>The editable values, to see whether anything changed.</summary>
        private object Values() => (FirstName.Trim(), LastName.Trim(), BirthDate, (City ?? "").Trim(), IsGuest,
            IsGuest ? ClubId : null, Rating);

        /// <summary>Takes the current values as the saved state.</summary>
        public void MarkClean() => _clean = Values();

        /// <summary>Something was changed that is not saved yet.</summary>
        public bool IsDirty => NewPhoto is not null || PhotoRemoved || !Equals(Values(), _clean);
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public DateTime? BirthDate { get; set; }
        public string? City { get; set; }
        public bool IsGuest { get; set; }
        public int? ClubId { get; set; }
        public int Rating { get; set; } = DefaultRating;

        /// <summary>A newly chosen photo that is uploaded on save.</summary>
        public byte[]? NewPhoto { get; private set; }
        public bool PhotoRemoved { get; private set; }

        /// <summary>What the avatar shows: the new photo, the current photo, or nothing.</summary>
        public string? PhotoSource { get; private set; } = photoUrl;

        public void SetNewPhoto(byte[] photo, string contentType)
        {
            NewPhoto = photo;
            PhotoRemoved = false;
            PhotoSource = $"data:{contentType};base64,{Convert.ToBase64String(photo)}";
        }

        public void RemovePhoto()
        {
            NewPhoto = null;
            PhotoRemoved = true;
            PhotoSource = null;
        }
    }
}
