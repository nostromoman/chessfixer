@inject NavigationManager Navigation

@* Sends a user who is not logged in to the login page; after logging in they come back to this page. *@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(returnUrl.Length == 0 ? "login" : $"login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
    }
}
