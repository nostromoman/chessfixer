@using ChessFixer.Shared.Pgn
@inject IStringLocalizer<Strings> L
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject TournamentApi Api
@inject IDialogService Dialogs

@* The moves of a played game in PGN (Portable Game Notation): paste them from a notation app or a scoresheet
   typed out, or read them from a photo of the handwritten scoresheet (a wizard: Claude reads, the user checks), and
   later copy, download or open them on an analysis board. When a wizard was left unfinished, the dialog first asks
   to continue it or to start over. Closes with the text to save ("" removes the moves). *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Description" />
            <MudText Typo="Typo.h6">@L["PgnTitle", Game.White.Name, Game.Black?.Name ?? "", L[$"Result_{Game.Result}"]]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_resume is { } resume)
        {
            <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.DocumentScanner" Class="mb-2">
                <div class="mb-1"><b>@L["WizardResumeTitle"]</b></div>
                <div>@ResumeText(resume)</div>
            </MudAlert>
            <div class="d-flex flex-wrap gap-2 justify-end">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestartAlt" OnClick="StartOverAsync"
                           Disabled="_busy">@L["WizardStartOver"]</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="() => OpenWizardAsync(resume)" Disabled="_busy">@L["WizardContinue"]</MudButton>
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["PgnHelp"]</MudText>
            @if (TournamentId > 0)
            {
                <div class="d-flex align-center flex-wrap gap-2 mb-1">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DocumentScanner"
                               OnClick="() => OpenWizardAsync(null)" Disabled="_busy">@L["ScoresheetButton"]</MudButton>
                </div>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">@L["ScoresheetHelp"]</MudText>
                @if (_photos is { Count: > 0 })
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-1">@L["ScoresheetPhotosKept", _photos.Count]</MudText>
                    <ScoresheetPhotos Photos="_photos" Compact="true" />
                }
            }
            <MudTextField T="string" @bind-Value="_text" Variant="Variant.Outlined" Lines="14"
                          Immediate="true" MaxLength="PgnText.MaxLength" Class="pgn-text"
                          Placeholder="@Placeholder" Error="@(ErrorText is not null)" ErrorText="@ErrorText" />
        }
    </DialogContent>
    <DialogActions>
        @if (Pgn is not null && _resume is null)
        {
            <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => Dialog.Close(string.Empty)">
                @L["PgnRemove"]
            </MudButton>
        }
        <MudSpacer />
        @if (Pgn is not null && ShowAnalysisLink)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.QueryStats" Href="@($"games/{Game.Id}")"
                       OnClick="() => Dialog.Cancel()">@L["PgnShowAnalysis"]</MudButton>
        }
        @if (IsValid && _resume is null)
        {
            <MudTooltip Text="@L["PgnCopy"]">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" aria-label="@L["PgnCopy"]" OnClick="CopyAsync" />
            </MudTooltip>
            <MudTooltip Text="@L["PgnDownload"]">
                <MudIconButton Icon="@Icons.Material.Filled.Download" aria-label="@L["PgnDownload"]"
                               Href="@DownloadUrl" download="@FileName" />
            </MudTooltip>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.OpenInNew"
                       Href="@LichessUrl" Target="_blank" rel="noopener noreferrer">@L["PgnAnalyse"]</MudButton>
        }
        <MudButton OnClick="() => Dialog.Cancel()">@L["Cancel"]</MudButton>
        @if (_resume is null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSave || _busy)"
                       OnClick="() => Dialog.Close(Normalized ?? string.Empty)">@L["Save"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter, EditorRequired] public GameDto Game { get; set; } = null!;

    /// <summary>The moves saved so far; null when none were added.</summary>
    [Parameter] public string? Pgn { get; set; }

    /// <summary>Show the button to the analysis page (not on the analysis page itself).</summary>
    [Parameter] public bool ShowAnalysisLink { get; set; } = true;

    /// <summary>Used as the Event tag when the pasted text has no header tags.</summary>
    [Parameter] public string TournamentTitle { get; set; } = "";

    /// <summary>The tournament of the game; needed to read a scoresheet photo (0: no photo button).</summary>
    [Parameter] public int TournamentId { get; set; }

    private string? _text;
    private bool _busy;

    /// <summary>A wizard that was left unfinished: asked first whether to continue it or to start over.</summary>
    private ScoresheetWizardDto? _resume;

    /// <summary>The photos of this game's scoresheet that are kept; null while loading (or without a tournament).</summary>
    private List<ScoresheetPhotoDto>? _photos;

    protected override async Task OnInitializedAsync()
    {
        _text = Pgn;
        await LoadPhotosAsync();
        await LoadWizardAsync();
    }

    private async Task LoadWizardAsync()
    {
        if (TournamentId <= 0) return;
        try
        {
            _resume = await Api.GetScoresheetWizardAsync(Game.Id);
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            _resume = null; // not essential: the moves can still be pasted
        }
    }

    private string ResumeText(ScoresheetWizardDto wizard)
    {
        var uploaded = wizard.UploadedAt.ToLocalTime().ToString("d MMM yyyy HH:mm");
        if (wizard.Review is { } review)
            return L["WizardResumeCheck", uploaded, review.Moves.Count(m => m.Checked), review.Moves.Count];
        return wizard.ReadStatus switch
        {
            ScoresheetReadStatus.Reading => L["WizardResumeReading", uploaded],
            ScoresheetReadStatus.Failed => L["WizardResumeFailed", uploaded],
            _ => L["WizardResumePhoto", uploaded]
        };
    }

    /// <summary>
    /// The wizard (a new one, or the one to continue). It closes with the checked moves as PGN: this dialog then closes
    /// with them, so they are saved (and analysed). Closed before that: the work is kept, and offered again here.
    /// </summary>
    private async Task OpenWizardAsync(ScoresheetWizardDto? wizard)
    {
        var dialog = await Dialogs.ShowAsync<ScoresheetWizardDialog>(null,
            new DialogParameters<ScoresheetWizardDialog> { { d => d.Game, Game }, { d => d.Wizard, wizard } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = false, BackdropClick = false });
        if (await dialog.Result is { Canceled: false, Data: string pgn } && pgn.Length > 0)
        {
            Dialog.Close(pgn);
            return;
        }
        await LoadPhotosAsync();
        await LoadWizardAsync();
    }

    /// <summary>Starts over: the unfinished wizard is closed (its photo is kept); then paste or read a new photo.</summary>
    private async Task StartOverAsync()
    {
        _busy = true;
        try
        {
            await Api.CloseScoresheetWizardAsync(Game.Id);
            _resume = null;
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            Snackbar.Add(e is ApiClientException { Code: { } code } ? L[$"Error_{code}"] : L["Error_ServerUnavailable"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadPhotosAsync()
    {
        if (TournamentId <= 0) return;
        try
        {
            _photos = await Api.GetScoresheetsAsync(Game.Id);
        }
        catch (Exception e) when (e is ApiClientException or HttpRequestException)
        {
            // Not essential: the dialog works without the photos.
        }
    }

    private const string Placeholder = "[White \"...\"]\n[Black \"...\"]\n\n1. e4 e5 2. Nf3 Nc6 3. Bc4 Bc5 ...";

    private string? Normalized => PgnText.Normalize(_text);

    private bool IsValid => Normalized is { } text && text.Length <= PgnText.MaxLength && PgnText.HasMoves(text);

    private string? ErrorText => Normalized is null || IsValid ? null : L["PgnNoMoves"].Value;

    /// <summary>Changed and either valid or emptied (which removes the moves).</summary>
    private bool CanSave => Normalized != PgnText.Normalize(Pgn) && (Normalized is null || IsValid);

    /// <summary>
    /// The text to copy or download. Without header tags (only the moves were pasted) the players, the tournament
    /// and the result are added, so an analysis program knows whose game it is.
    /// </summary>
    private string Export
    {
        get
        {
            var text = Normalized ?? "";
            if (text.StartsWith('[')) return text + "\n";
            var result = Game.Result switch
            {
                GameResult.WhiteWins => "1-0",
                GameResult.BlackWins => "0-1",
                GameResult.Draw => "1/2-1/2",
                _ => "*"
            };
            return $"[Event \"{Tag(TournamentTitle)}\"]\n[White \"{Tag(Game.White.Name)}\"]\n" +
                   $"[Black \"{Tag(Game.Black?.Name ?? "?")}\"]\n[Result \"{result}\"]\n\n{text}\n";
        }
    }

    private static string Tag(string value) => value.Replace("\\", "\\\\").Replace("\"", "\\\"");

    private string FileName =>
        string.Concat($"{Game.White.Name} - {Game.Black?.Name}.pgn".Split(Path.GetInvalidFileNameChars()));

    private string DownloadUrl => "data:application/x-chess-pgn;charset=utf-8," + Uri.EscapeDataString(Export);

    /// <summary>The Lichess analysis board replays the moves (without comments and variations).</summary>
    private string LichessUrl => "https://lichess.org/analysis/pgn/" + Uri.EscapeDataString(PgnText.MoveText(Normalized ?? ""));

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Export);
            Snackbar.Add(L["PgnCopied"], Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(L["Error_Unknown"], Severity.Error);
        }
    }
}
