@inject TournamentApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IStringLocalizer<Strings> L

@* The players of one tournament with their status. Players are added with the search field and the + button:
   pick an existing player, or type a name that does not exist yet to create a new player (first name only). *@
<div class="d-flex align-center gap-2 mb-3">
    <MudSpacer />
    <div class="player-search">
        <MudAutocomplete @ref="_search" T="PlayerDto" Placeholder="@L["SearchOrNewPlayer"]" Variant="Variant.Outlined"
                         Margin="Margin.Dense" SearchFunc="SearchAsync" ToStringFunc="@(p => p?.Name)"
                         ValueChanged="OnPickedAsync" TextChanged="t => _searchText = t"
                         Disabled="@(!CanAddPlayers)" ResetValueOnEmptyText="true" CoerceText="false"
                         Clearable="true" AdornmentIcon="@Icons.Material.Filled.Search">
            <ItemTemplate Context="player">
                @if (player.Id == NewPlayerId)
                {
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
                        <span>@L["NewPlayerOption", player.Name]</span>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center gap-2">
                        <PlayerAvatar FirstName="@player.FirstName" LastName="@player.LastName" PhotoUrl="@player.PhotoUrl" />
                        @player.Name
                        <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">(@player.Rating)</MudText>
                        @if (player.IsGuest)
                        {
                            <GuestChip ClubName="@player.ClubName" />
                        }
                    </div>
                }
            </ItemTemplate>
            <NoItemsTemplate>
                <MudText Class="pa-3" Typo="Typo.body2">@L["NoMatchingPlayers"]</MudText>
            </NoItemsTemplate>
        </MudAutocomplete>
    </div>
    <MudTooltip Text="@(LockReason ?? L["AddPlayer"])">
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" aria-label="@L["AddPlayer"]"
                Disabled="@(!CanAddPlayers || _adding || string.IsNullOrWhiteSpace(_searchText))" OnClick="AddTypedAsync" />
    </MudTooltip>
</div>

@if (LockReason is { } reason)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@reason</MudAlert>
}

@if (Participants.Count == 0)
{
    <MudText Typo="Typo.body2">@L["NoPlayers"]</MudText>
}
else
{
    @if (AbsentCount > 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["PresentCount", ActiveCount - AbsentCount, ActiveCount]</MudText>
    }
    <MudSimpleTable Dense="true" Hover="true" Striped="true" Elevation="0">
        <thead>
            <tr>
                <th style="width: 1%">
                    <MudTooltip Text="@L["PresentHelp"]">@L["PresentShort"]</MudTooltip>
                </th>
                <th style="width: 3em"></th>
                <th>@L["Name"]</th>
                <th class="hide-xs" style="text-align: right">@L["Rating"]</th>
                <th class="hide-xs">@L["State"]</th>
                <th style="width: 1%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var player in Participants)
            {
                var info = Players.GetValueOrDefault(player.PlayerId);
                var status = StatusOf(player);
                <tr class="@(!player.IsActive ? "withdrawn" : !player.IsPresent ? "absent" : null)">
                    <td>
                        @if (player.IsActive)
                        {
                            var noAbsence = IsRoundRobin && player.IsPresent;
                            <MudTooltip Text="@(PresenceLocked ? L["PresenceLockedInRound"] : noAbsence ? L["PresenceRoundRobin"] : L["Present"])">
                                <MudCheckBox T="bool" Value="player.IsPresent" ValueChanged="v => SetPresenceAsync(player, v)"
                                             Color="Color.Primary" Dense="true" Size="Size.Small" aria-label="@L["Present"]"
                                             Disabled="@(!CanChangePlayers || Disabled || PresenceLocked || noAbsence)" />
                            </MudTooltip>
                        }
                    </td>
                    <td><PlayerAvatar FirstName="@(info?.FirstName ?? player.Name)" LastName="@info?.LastName" PhotoUrl="@info?.PhotoUrl" /></td>
                    <td>
                        @{ var playerId = player.PlayerId; }
                        <MudLink OnClick="() => OnOpenPlayer.InvokeAsync(playerId)" Disabled="@(info is null)">
                            <PlayerName Name="@player.Name" IsDeleted="player.IsDeleted" />
                        </MudLink>
                        @if (info is { IsGuest: true })
                        {
                            <GuestChip ClubName="@info.ClubName" />
                        }
                    </td>
                    <td class="hide-xs" style="text-align: right">@player.Rating</td>
                    <td class="hide-xs">
                        <MudChip T="string" Size="Size.Small" Class="ma-0" Color="@StatusColor(status)"
                                 Variant="@(status == PlayerStatus.Playing ? Variant.Filled : Variant.Outlined)">
                            @StatusText(status)
                        </MudChip>
                    </td>
                    <td style="text-align: right; white-space: nowrap">
                        @if (player.IsActive)
                        {
                            <MudTooltip Text="@(InGame(status) ? L["RemoveBlockedInGame"] : L["Remove"])">
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small"
                                               Color="Color.Error" aria-label="@L["Remove"]"
                                               Disabled="@(!CanChangePlayers || Disabled || InGame(status))"
                                               OnClick="() => RemoveAsync(player)" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@L["Rejoin"]">
                                <MudIconButton Icon="@Icons.Material.Filled.PersonAddAlt1" Size="Size.Small"
                                               Color="Color.Success" aria-label="@L["Rejoin"]"
                                               Disabled="@(!CanChangePlayers || Disabled)"
                                               OnClick="() => RejoinAsync(player)" />
                            </MudTooltip>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    private enum PlayerStatus { Waiting, WaitingForBoard, Playing, Bye, Absent, Withdrawn, Finished }

    [Parameter, EditorRequired] public TournamentDto Tournament { get; set; } = null!;
    [Parameter, EditorRequired] public List<TournamentPlayerDto> Participants { get; set; } = [];
    [Parameter, EditorRequired] public List<RoundDto> Rounds { get; set; } = [];

    /// <summary>The central player list by id: for searching, and for names and photos.</summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<int, PlayerDto> Players { get; set; } = null!;

    [Parameter] public bool CanChangePlayers { get; set; }

    /// <summary>Opens the player drawer for the player with this id.</summary>
    [Parameter] public EventCallback<int> OnOpenPlayer { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Runs an API action on the page (error handling and reload), with an optional success message.</summary>
    [Parameter, EditorRequired] public Func<Func<Task>, string?, Task> Run { get; set; } = null!;

    private MudAutocomplete<PlayerDto>? _search;
    private string? _searchText;
    private bool _adding;

    private string? LockReason => Tournament.State switch
    {
        TournamentState.Closed => L["PlayersLockedClosed"].Value,
        _ when PlayerListFixed => L["PlayersLockedRoundRobin"].Value,
        _ => null
    };

    private bool IsRoundRobin => Tournament.Settings.PairingSystem == PairingSystem.RoundRobin;

    /// <summary>Round robin is for a fixed group: no new players once round 1 has started (withdrawn players can rejoin).</summary>
    private bool PlayerListFixed => IsRoundRobin && Tournament.SettingsLocked;

    private bool CanAddPlayers => CanChangePlayers && !PlayerListFixed;

    private PlayerStatus StatusOf(TournamentPlayerDto player)
    {
        if (!player.IsActive) return PlayerStatus.Withdrawn;
        if (Tournament.State == TournamentState.Closed) return PlayerStatus.Finished;
        if (Tournament.State != TournamentState.RoundActive) return player.IsPresent ? PlayerStatus.Waiting : PlayerStatus.Absent;

        var round = Rounds.LastOrDefault(r => r.IsStarted);
        var game = round?.Games.FirstOrDefault(g => g.White.PlayerId == player.PlayerId || g.Black?.PlayerId == player.PlayerId);
        return game switch
        {
            null => player.IsPresent ? PlayerStatus.Waiting : PlayerStatus.Absent, // joined during this round
            { Result: GameResult.Absent } => PlayerStatus.Absent,
            { Black: null } => PlayerStatus.Bye,
            { Result: GameResult.NotPlayed, Board: null } => PlayerStatus.WaitingForBoard,
            { Result: GameResult.NotPlayed } => PlayerStatus.Playing,
            _ => player.IsPresent ? PlayerStatus.Waiting : PlayerStatus.Absent // game finished, waiting for the others
        };
    }

    /// <summary>During a round the presence cannot change (the server refuses it too).</summary>
    private bool PresenceLocked => Tournament.State == TournamentState.RoundActive;

    private int ActiveCount => Participants.Count(p => p.IsActive);
    private int AbsentCount => Participants.Count(p => p is { IsActive: true, IsPresent: false });

    /// <summary>Playing or waiting for a board: cannot withdraw until the game is finished.</summary>
    private static bool InGame(PlayerStatus status) => status is PlayerStatus.Playing or PlayerStatus.WaitingForBoard;

    private string StatusText(PlayerStatus status) => status switch
    {
        PlayerStatus.Withdrawn => L["Withdrawn"],
        _ => L[$"Status_{status}"]
    };

    private static Color StatusColor(PlayerStatus status) => status switch
    {
        PlayerStatus.Playing => Color.Success,
        PlayerStatus.Bye => Color.Info,
        PlayerStatus.Absent => Color.Secondary,
        PlayerStatus.Waiting or PlayerStatus.WaitingForBoard => Color.Warning,
        _ => Color.Default
    };

    /// <summary>Players from the central list that are not in this tournament yet (withdrawn players rejoin from the table).</summary>
    private IEnumerable<PlayerDto> Candidates(string? text)
    {
        var inTournament = Participants.Select(p => p.PlayerId).ToHashSet();
        return AvailablePlayers
            .Where(p => !inTournament.Contains(p.Id))
            .Where(p => string.IsNullOrWhiteSpace(text) || p.Name.Contains(text.Trim(), StringComparison.CurrentCultureIgnoreCase))
            .OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase);
    }

    /// <summary>Players that can join: <see cref="Players"/> also holds deleted players, for the ones in this tournament.</summary>
    private IEnumerable<PlayerDto> AvailablePlayers => Players.Values.Where(p => !p.IsDeleted);

    /// <summary>Id of the extra list item "add ... as new player"; real players have positive ids.</summary>
    private const int NewPlayerId = 0;

    /// <summary>
    /// Matching players, plus an item to create a new player when no player has exactly the typed name.
    /// The new-player item is a normal list item, so Enter and clicking work the same as for a player.
    /// </summary>
    private Task<IEnumerable<PlayerDto>> SearchAsync(string? text, CancellationToken cancellationToken)
    {
        var items = Candidates(text).ToList();
        var name = text?.Trim();
        if (!string.IsNullOrEmpty(name)
            && !AvailablePlayers.Any(p => string.Equals(p.Name, name, StringComparison.CurrentCultureIgnoreCase)))
            items.Add(new PlayerDto(NewPlayerId, name, "", name, 0, null, null, null));
        return Task.FromResult<IEnumerable<PlayerDto>>(items);
    }

    /// <summary>An item picked from the list: an existing player, or the new-player item.</summary>
    private async Task OnPickedAsync(PlayerDto? player)
    {
        if (player is null) return;
        if (player.Id == NewPlayerId) await AddByNameAsync(player.Name);
        else await AddAsync(() => Api.AddPlayerAsync(Tournament.Id, player.Id), L["PlayerAdded", player.Name]);
    }

    /// <summary>The + button: adds the typed name.</summary>
    private Task AddTypedAsync() => AddByNameAsync(_searchText);

    /// <summary>
    /// An existing player with exactly this name is added (or rejoins);
    /// otherwise a new player is created with the name as first name.
    /// </summary>
    private async Task AddByNameAsync(string? text)
    {
        var name = text?.Trim();
        if (string.IsNullOrEmpty(name)) return;

        var existing = AvailablePlayers.FirstOrDefault(p => string.Equals(p.Name, name, StringComparison.CurrentCultureIgnoreCase));
        var participant = existing is null ? null : Participants.FirstOrDefault(p => p.PlayerId == existing.Id);

        if (participant is { IsActive: true })
        {
            Snackbar.Add(L["Error_PlayerAlreadyInTournament"], Severity.Warning);
            await ClearSearchAsync();
        }
        else if (participant is not null)
            await AddAsync(() => Api.AddPlayerAsync(Tournament.Id, participant.PlayerId), L["PlayerRejoined", participant.Name]);
        else if (existing is not null)
            await AddAsync(() => Api.AddPlayerAsync(Tournament.Id, existing.Id), L["PlayerAdded", existing.Name]);
        else
            await AddAsync(async () =>
            {
                var player = await Api.CreatePlayerAsync(new CreatePlayerRequest(name, null, null));
                await Api.AddPlayerAsync(Tournament.Id, player.Id);
                Snackbar.Add(L["PlayerAdded", player.Name], Severity.Success);
            }, null);
    }

    /// <summary>Runs one add action at a time (ignores a second Enter or click meanwhile) and clears the search field.</summary>
    private async Task AddAsync(Func<Task> action, string? successMessage)
    {
        if (_adding || !CanAddPlayers) return;
        _adding = true;
        try
        {
            await Run(action, successMessage);
        }
        finally
        {
            _adding = false;
        }
        await ClearSearchAsync();
    }

    private async Task ClearSearchAsync()
    {
        _searchText = null;
        if (_search is not null) await _search.ClearAsync();
    }

    /// <summary>
    /// Taking a player out of the tournament is not the same as being absent for an evening, so it is always
    /// confirmed; the dialog also offers to mark the player absent instead.
    /// </summary>
    private async Task RemoveAsync(TournamentPlayerDto player)
    {
        var gameCount = Rounds.Where(r => r.IsStarted).SelectMany(r => r.Games)
            .Count(g => g.Black is not null && (g.White.PlayerId == player.PlayerId || g.Black.PlayerId == player.PlayerId));
        var dialog = await Dialogs.ShowAsync<RemovePlayerDialog>(null,
            new DialogParameters<RemovePlayerDialog>
            {
                { d => d.Name, player.Name },
                { d => d.GameCount, gameCount },
                { d => d.IsPresent, player.IsPresent && !PresenceLocked },
                { d => d.IsRoundRobin, IsRoundRobin }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true });

        switch ((await dialog.Result)?.Data)
        {
            case RemovePlayerDialog.RemovePlayerChoice.Remove:
                await Run(() => Api.RemovePlayerAsync(Tournament.Id, player.PlayerId), L["PlayerRemoved", player.Name]);
                break;
            case RemovePlayerDialog.RemovePlayerChoice.MarkAbsent:
                await Run(() => Api.SetPresenceAsync(Tournament.Id, player.PlayerId, false), L["PlayerMarkedAbsent", player.Name]);
                break;
        }
    }

    private Task SetPresenceAsync(TournamentPlayerDto player, bool isPresent) =>
        Run(() => Api.SetPresenceAsync(Tournament.Id, player.PlayerId, isPresent), null);

    private Task RejoinAsync(TournamentPlayerDto player) =>
        Run(() => Api.AddPlayerAsync(Tournament.Id, player.PlayerId), L["PlayerRejoined", player.Name]);
}
