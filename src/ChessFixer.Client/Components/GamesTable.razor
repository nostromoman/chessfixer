@inject IStringLocalizer<Strings> L

@* The games of one round: board, white, result, black. *@
<MudSimpleTable Dense="@(!Large)" Hover="true" Bordered="false" Striped="true" Class="@(Large ? "games-large" : null)">
    <thead>
        <tr>
            <th style="width: 4em">@L["Board"]</th>
            <th>@L["White"]</th>
            <th style="text-align: center">@L["Result"]</th>
            <th>@L["Black"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Round.Games)
        {
            <tr>
                <td>@game.Board</td>
                <td>@game.White.Name</td>
                <td style="text-align: center; white-space: nowrap">
                    @if (Round.IsStarted)
                    {
                        <GameResultCell Game="game" Editable="Editable" Disabled="Disabled"
                                        OnResult="result => OnResult.InvokeAsync((game, result))" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">-</MudText>
                    }
                </td>
                <td>@(game.Black?.Name ?? L["ByeOpponent"])</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    [Parameter, EditorRequired] public RoundDto Round { get; set; } = null!;
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Larger text, for the pairing that players read from a distance.</summary>
    [Parameter] public bool Large { get; set; }

    [Parameter] public EventCallback<(GameDto Game, GameResult Result)> OnResult { get; set; }
}
